---
/**
 * 顶部导航栏（Editorial 风格）
 * 左侧：站点标识（可选小头像 + mono 大写站名）
 * 右侧：外部快捷链接（纯文字）+ 主题切换按钮
 * 文案与链接来自 site.ts / links.ts / appearance.ts
 */
import { getSiteConfig, getNavigation, getAppearance } from '../lib/queries';
import ThemeToggle from './ThemeToggle.astro';

const siteConfig = getSiteConfig();
const appearance = getAppearance();
const { avatar } = appearance;
/** 是否展示头像图片（未配置时仅显示站名，避免空白占位） */
const showAvatarImage = avatar.enabled && avatar.src !== '';
/** 顶部展示全部 quick 导航（内部/外部链接均可，external 仅决定是否新窗口打开） */
const headerLinks = getNavigation('quick');
---

<header class="header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={siteConfig.name}>
      {showAvatarImage && (
        <img class="brand-avatar" src={avatar.src} alt="" width="20" height="20" />
      )}
      <span class="brand-name">{siteConfig.name}</span>
    </a>
    <nav class="header-nav" aria-label="顶部导航">
      <a href="/blog" class="header-link">文章</a>
      <a href="/tools" class="header-link">工具</a>
      {
        headerLinks.map((link) => (
          <a
            href={link.url}
            class="header-link"
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.name}
          </a>
        ))
      }
      <button type="button" id="style-switch" class="style-switch" title="切换经典与温和杂志风格">经典风格</button><ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 28px;
  }

  /* 站点标识：mono 大写 + 字距，建立品牌印记 */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .brand-avatar {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    object-fit: cover;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  /* 顶部链接：mono 小字，hover 变前景色 */
  .header-link {
    flex-shrink:0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    transition: color var(--transition-fast);
  }

  .header-link:hover {
    color: var(--color-foreground);
  }

  @media (max-width: 640px) {
    .header-inner {
      padding-block: 20px;
    }

    .header-nav {
      gap: 12px;
      overflow-x:auto;
      max-width:70%;
      white-space:nowrap;
      padding:5px 0;
      scrollbar-width:thin;
    }
  }
</style>

<script>
const styleButton = document.getElementById('style-switch');
function refreshStyle() {
  if (styleButton)
    styleButton.textContent =
      document.documentElement.dataset.style === 'classic'
        ? '杂志风格'
        : '经典风格';
}
refreshStyle();
styleButton?.addEventListener('click', () => {
  const style =
    document.documentElement.dataset.style === 'classic'
      ? 'magazine'
      : 'classic';
  document.documentElement.dataset.style = style;
  try {
    localStorage.setItem('blog-style', style);
  } catch {}
  refreshStyle();
});
</script>