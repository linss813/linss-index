---
import {formatShanghai} from '../lib/datetime';
import type { SidebarModule } from '../services/sidebars';
import Icon from './Icon.astro';
import {sanitizeArticleHtml} from '../services/blog';
const {module:m,data,preview=false} = Astro.props as {module:SidebarModule;data:{articlesUpdated:any[];articles:any[];moments:any[];messages:any[];stats:{label:string;count:number}[]};preview?:boolean};
const list=m.kind==='articles'?[...(m.sort==='updated'?data.articlesUpdated:data.articles)].sort((a,b)=>String(m.sort==='updated'?b.updated_at:b.published_at).localeCompare(String(m.sort==='updated'?a.updated_at:a.published_at))):m.kind==='moments'?data.moments:m.kind==='guestbook'?data.messages:[];
const hidden=['articles','moments','guestbook'].includes(m.kind)&&!list.length;
---
{(!hidden||preview)&&<section class:list={['sidebar-card',`card-${m.kind}`,{'mobile-hidden':!m.mobile,'desktop-hidden':m.desktop===false,'tablet-hidden':m.tablet===false}]} data-module-id={m.id} style={`--mobile-order:${m.order||0}`}>{m.kind==='ad'&&<small class="sponsored">推广</small>}<header><h2>{m.title}</h2><button type="button" class="collapse-card" aria-label={`折叠${m.title}`} aria-expanded="true">⌃</button></header>{hidden&&preview&&<p class="description">当前暂无已公开内容，前台自动隐藏此卡片。</p>}
{m.image&&<img src={m.image} class:list={{'profile-avatar':m.kind==='profile'}} alt={m.imageAlt||m.title} loading="lazy"/>}
{m.kind==='profile'&&m.profileName&&<strong class="profile-name">{m.profileName}</strong>}
{m.kind==='text'&&m.contentHtml?<div class="card-prose" set:html={sanitizeArticleHtml(m.contentHtml,Astro.url.origin)}/>:m.content&&<p class="description">{m.content}</p>}
{(m.kind==='links'||m.kind==='profile')&&m.links.length>0&&<div class="quick-grid">{m.links.map(link=><a href={link.url}><Icon name={link.icon} size={17}/><span>{link.name}</span></a>)}</div>}
{m.kind==='articles'&&<div class="rows">{list.slice(0,m.limit).map(a=><a href={`/blog/${encodeURIComponent(a.slug)}`}>{m.thumbnail&&a.cover_url&&<img src={a.cover_url} alt="" loading="lazy"/>}<strong>{a.title}</strong><time>{a.published_at?.slice(0,10)}</time></a>)}</div>}
{m.kind==='moments'&&<div class="rows">{list.slice(0,m.limit).map(a=><a href={`/moments/${a.id}`}><p>{a.content.slice(0,100)}</p>{JSON.parse(a.images_json||'[]')[0]&&<img src={JSON.parse(a.images_json)[0]} alt="动态照片" loading="lazy"/>}<time>{formatShanghai(a.created_at).slice(0,10)}</time></a>)}</div>}
{m.kind==='guestbook'&&<div class="rows">{list.slice(0,m.limit).map(a=><a href="/#guestbook"><strong><span class="guest-avatar" aria-hidden="true">✦</span>{a.name}</strong><p>{a.content.slice(0,100)}</p></a>)}</div>}
{m.kind==='stats'&&<div class="stats">{data.stats.filter(s=>!m.metrics||m.metrics.includes(s.label as '文章'|'动态'|'留言')).map(s=><div><strong>{s.count}</strong><span>{s.label}</span></div>)}</div>}
{m.url&&<a class="more" href={m.url} rel={m.kind==='ad'?'sponsored noopener':undefined}>了解更多 ↗</a>}
</section>}
<style>.sidebar-card{background:var(--color-card,#fff);border:1px solid var(--color-border,#e4e6e9);border-radius:12px;padding:16px;overflow:hidden;font-family:system-ui,sans-serif}.sidebar-card header{margin-bottom:12px}h2{font:600 14px system-ui,sans-serif;line-height:1.4}.description{font-size:13px;line-height:1.7;color:var(--color-muted,#77818d);white-space:pre-wrap;margin-bottom:12px}img{width:100%;max-height:180px;object-fit:cover;border-radius:7px;margin-bottom:10px}.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.quick-grid a{display:flex;flex-direction:column;align-items:center;gap:7px;padding:10px 4px;border-radius:7px;font-size:12px;background:color-mix(in srgb,var(--color-muted,#77818d) 5%,transparent)}a{color:inherit;text-decoration:none}a:hover{color:var(--color-accent,#507d83)}.rows{display:grid;gap:12px}.rows>a+a{border-top:1px solid var(--color-border,#e4e6e9);padding-top:12px}.rows strong{font-size:13px;font-weight:500;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.6}.rows p{font-size:12px;line-height:1.7;color:var(--color-muted,#77818d);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;margin:4px 0}time{font-size:10px;color:var(--color-muted,#77818d);display:block;margin-top:5px}.more{font-size:12px;display:block;margin-top:12px;color:var(--color-accent,#507d83)}.sponsored{font-size:10px;color:var(--color-muted,#77818d)}.stats{display:grid;grid-template-columns:repeat(3,1fr);text-align:center}.stats strong{display:block;font-size:19px}.stats span{font-size:11px;color:var(--color-muted,#77818d)}@media(max-width:1023px){.mobile-hidden{display:none}}</style>
<style>.sidebar-card header{display:flex;justify-content:space-between;gap:8px}.collapse-card{font-size:14px;color:var(--color-muted);padding:0 4px}.is-collapsed>:not(header){display:none}.is-collapsed header{margin:0}.is-collapsed .collapse-card{transform:rotate(180deg)}.guest-avatar{display:inline-grid;place-items:center;width:23px;height:23px;border-radius:8px;background:color-mix(in srgb,var(--color-accent) 12%,transparent);color:var(--color-accent);margin-right:7px}.rows img{max-height:100px;margin-top:7px}.sidebar-card{flex-shrink:0;box-sizing:border-box}</style><style>.card-prose{font-size:13px;line-height:1.75;color:var(--color-muted)}.card-prose :global(ul),.card-prose :global(ol){padding-left:18px}.card-prose :global(p){margin:8px 0}.card-prose :global(a){color:var(--color-accent);text-decoration:underline}</style><style>.profile-avatar{width:48px;height:48px;border-radius:50%;object-fit:cover}.profile-name{font-size:14px;display:block;margin:8px 0}</style>