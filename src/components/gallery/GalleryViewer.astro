---
/**
 * 相册图片查看器（轻量灯箱，v2.5.0 增强）
 * 功能：缩略图先行占位（模糊放大，高清预览加载后淡入替换）/ 查看原图·下载原图按钮
 *      高清预览 / 上一张下一张 / ESC·遮罩·键盘关闭 / 移动端滑动
 *      底部 Thumbnail Strip / 鼠标滚轮缩放（1x–4x）+ 拖动平移 + 双击恢复 + 移动端双指缩放
 *      Info 信息面板（metadata，按 API 公开字段渲染） / 相邻预览图预加载 / 加载失败点击重试
 */
import type { GalleryItem } from '../../types/gallery';
import GalleryThumbnails from './GalleryThumbnails.astro';
import GalleryInfoPanel from './GalleryInfoPanel.astro';

interface Props {
  /** 公开照片列表（与 Grid 数据一致） */
  items: GalleryItem[];
}

const { items } = Astro.props;
/** 序列化供内联脚本读取（thumbnail 供缩略图条，metadata 已由 API 过滤） */
const photosJson = JSON.stringify(
  items.map((it) => ({
    image: it.image,
    thumbnail: it.thumbnail ?? it.image,
    preview: it.preview ?? it.image,
    title: it.title ?? '',
    description: it.description ?? '',
    width: it.width ?? 0,
    height: it.height ?? 0,
    fileSize: it.fileSize ?? 0,
    mimeType: it.mimeType ?? '',
    metadata: it.metadata ?? {},
  }))
).replace(/"/g, '&quot;');
---

<div class="viewer" id="galleryViewer" data-photos={photosJson} hidden>
  <div class="viewer-backdrop" data-viewer-close></div>

  <div class="viewer-stage" role="dialog" aria-modal="true" aria-label="图片查看器">
    <div class="viewer-top">
      <button type="button" class="viewer-btn" id="viewerInfoBtn" aria-label="图片信息">i</button>
      <button type="button" class="viewer-btn viewer-open" id="viewerOpen" aria-label="在当前页面查看原图" title="查看原图" aria-pressed="false" hidden>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="8 3 3 3 3 8" />
          <polyline points="16 3 21 3 21 8" />
          <polyline points="8 21 3 21 3 16" />
          <polyline points="16 21 21 21 21 16" />
        </svg>
      </button>
      <a class="viewer-btn viewer-download" id="viewerDownload" href="#" download aria-label="下载原图" title="下载原图" hidden>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
      </a>
      <button type="button" class="viewer-btn" id="viewerClose" aria-label="关闭">×</button>
    </div>

    <div class="viewer-canvas" id="viewerCanvas">
      <img class="viewer-image viewer-placeholder" id="viewerPlaceholder" alt="" aria-hidden="true" />
      <img class="viewer-image" id="viewerImage" alt="" draggable="false" />
      <div class="viewer-loading" id="viewerLoading" role="status" aria-live="polite" hidden>
        <span class="viewer-spinner" aria-hidden="true"></span>
        <span id="viewerLoadingText">高清预览加载中…</span>
      </div>
      <div class="viewer-fail" id="viewerFail" hidden>加载失败，点击重试</div>
      <button type="button" class="viewer-btn viewer-nav viewer-prev" id="viewerPrev" aria-label="上一张">‹</button>
      <button type="button" class="viewer-btn viewer-nav viewer-next" id="viewerNext" aria-label="下一张">›</button>
    </div>

    <div class="viewer-caption" id="viewerCaption">
      <span class="viewer-title" id="viewerTitle"></span>
      <span class="viewer-desc" id="viewerDesc"></span>
    </div>

    <GalleryThumbnails items={items} />
  </div>

  <GalleryInfoPanel item={items[0]} />
</div>

<script>
  const viewer = document.getElementById('galleryViewer')!;
  const viewerImage = document.getElementById('viewerImage') as HTMLImageElement;
  /** 缩略图占位层：高清预览加载期间显示模糊放大的缩略图，避免白屏等待 */
  const viewerPlaceholder = document.getElementById('viewerPlaceholder') as HTMLImageElement;
  const viewerLoading = document.getElementById('viewerLoading') as HTMLElement;
  const viewerLoadingText = document.getElementById('viewerLoadingText') as HTMLElement;
  const viewerFail = document.getElementById('viewerFail') as HTMLElement;
  const viewerCanvas = document.getElementById('viewerCanvas')!;
  const viewerTitle = document.getElementById('viewerTitle')!;
  const viewerDesc = document.getElementById('viewerDesc')!;
  const viewerCaption = document.getElementById('viewerCaption')!;
  const infoBtn = document.getElementById('viewerInfoBtn') as HTMLButtonElement;
  /** 在当前灯箱内切换“优化预览 / 完整原图”的按钮。 */
  const viewerOpen = document.getElementById('viewerOpen') as HTMLButtonElement;
  /** 「下载原图」链接：带 download 属性，本地上传文件可直接触发下载 */
  const viewerDownload = document.getElementById('viewerDownload') as HTMLAnchorElement;
  const infoPanel = document.getElementById('galleryInfoPanel') as HTMLElement;
  const thumbTrack = document.getElementById('galleryThumbTrack')!;

  /** 展示数据（服务端渲染注入，metadata 已按公开配置过滤） */
  const PHOTOS: {
    image: string; thumbnail: string; preview: string; title: string; description: string;
    width: number; height: number; fileSize: number; mimeType: string;
    metadata: Record<string, unknown>;
  }[] = JSON.parse((viewer.dataset.photos ?? '[]').replace(/&quot;/g, '"'));

  /** 当前照片索引 */
  let current = -1;
  /* ---------- 缩放状态 ---------- */
  /** 当前缩放倍数（1 = 原始适配尺寸） */
  let scale = 1;
  /** 缩放上下限（§29：min 1 / max 4，避免无限放大） */
  const SCALE_MIN = 1;
  const SCALE_MAX = 4;
  /** 平移偏移（px） */
  let panX = 0;
  let panY = 0;
  /** 鼠标拖动必须由按下的主键持续维持；用于处理 pointerup 丢失场景。 */
  let dragging = false;
  let dragPointerId: number | null = null;
  let dragLast: { x: number; y: number } | null = null;
  /** 滚轮高频事件合并到每个动画帧，避免一张 12MP 图片在同一帧重复重绘。 */
  let wheelTargetScale = 1;
  let wheelFrame: number | null = null;
  let wheelEndTimer: number | null = null;

  /**
   * 渲染令牌：每次切换照片自增。
   * 快速连续切换时，旧图片的 load / error 回调携带过期令牌将被丢弃，
   * 避免旧回调覆盖新照片的显示状态（竞态防护）。
   */
  let renderToken = 0;
  /** 当前主图是否正在展示完整原图（默认使用优化预览）。 */
  let showingOriginal = false;

  /** 是否可交互 */
  function active(): boolean {
    return current >= 0 && current < PHOTOS.length;
  }

  /** 打开查看器并定位到指定索引 */
  function openViewer(index: number): void {
    if (!PHOTOS.length) return;
    current = Math.min(Math.max(index, 0), PHOTOS.length - 1);
    viewer.hidden = false;
    document.body.style.overflow = 'hidden';
    render();
    (document.getElementById('viewerClose') as HTMLButtonElement).focus();
  }

  /** 关闭查看器并恢复滚动 */
  function closeViewer(): void {
    viewer.hidden = true;
    document.body.style.overflow = '';
    current = -1;
    resetZoom();
    viewer.classList.remove('info-open');
  }

  /** 切换照片（环形） */
  function step(delta: number): void {
    if (!active()) return;
    current = (current + delta + PHOTOS.length) % PHOTOS.length;
    render();
    preloadNeighbors();
  }

  /** 应用缩放与平移到图片元素 */
  function applyTransform(): void {
    viewerImage.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
    viewerImage.style.cursor = dragging ? 'grabbing' : scale > 1 ? 'grab' : 'zoom-in';
  }

  /** 重置缩放到 100% 适配 */
  function resetZoom(): void {
    stopDragging();
    if (wheelFrame != null) cancelAnimationFrame(wheelFrame);
    if (wheelEndTimer != null) window.clearTimeout(wheelEndTimer);
    wheelFrame = null;
    wheelEndTimer = null;
    wheelTargetScale = 1;
    viewerImage.classList.remove('is-transforming');
    scale = 1;
    panX = 0;
    panY = 0;
    applyTransform();
  }

  /** 缩放（钳制上下限；scale=1 时平移归零避免图片漂移） */
  function zoomTo(next: number): void {
    scale = Math.min(SCALE_MAX, Math.max(SCALE_MIN, next));
    if (scale === 1) { panX = 0; panY = 0; }
    applyTransform();
  }

  /**
   * 渲染当前照片：缩略图先行占位 → 屏幕尺寸高清预览异步加载淡入替换
   * 原图只在用户明确点击“查看原图 / 下载原图”时请求。
   */
  function render(): void {
    const p = PHOTOS[current];
    if (!p) return;
    loadViewerImage(p, false);
    viewerTitle.textContent = p.title;
    viewerDesc.textContent = p.description;
    viewerCaption.style.display = p.title || p.description ? '' : 'none';
    updateInfoPanel(p);
    updateThumbHighlight();
  }

  /** 在当前灯箱加载优化预览或完整原图，并统一维护占位、提示与竞态令牌。 */
  function loadViewerImage(p: (typeof PHOTOS)[number], original: boolean): void {
    const token = ++renderToken;
    resetZoom();
    showingOriginal = original;
    viewerFail.hidden = true;
    viewerLoading.hidden = false;
    const originalSize = original ? formatBytes(p.fileSize) : null;
    viewerLoadingText.textContent = original
      ? `完整原图加载中…${originalSize ? ` 约 ${originalSize}` : ' 文件较大，请稍候'}`
      : '高清预览加载中… 首次打开可能需要一点时间';
    // 加载原图时以已缓存的高清预览占位；加载预览时用列表缩略图占位。
    viewerPlaceholder.src = original ? p.preview : p.thumbnail;
    viewerPlaceholder.classList.toggle('is-sharp', original);
    viewerPlaceholder.style.opacity = '1';
    // 主图层先透明，加载完成后淡入；令牌用于丢弃快速切换产生的过期回调。
    viewerImage.style.opacity = '0';
    viewerImage.dataset.token = String(token);
    viewerImage.fetchPriority = 'high';
    viewerImage.src = original ? p.image : p.preview;
    viewerImage.alt = p.title || 'Gallery image';
    updateOpenButtons(p);
    // 目标图片可能已被浏览器缓存，需同步检查完成状态。
    if (viewerImage.complete && viewerImage.naturalWidth > 0 && token === renderToken) {
      viewerImage.style.opacity = '1';
      viewerPlaceholder.style.opacity = '0';
      viewerLoading.hidden = true;
      updateOpenButtons(p);
    }
  }

  /**
   * 更新「查看原图 / 下载原图」按钮状态
   * @param p 当前照片数据
   */
  function updateOpenButtons(p: (typeof PHOTOS)[number]): void {
    viewerDownload.href = p.image;
    viewerOpen.hidden = p.preview === p.image;
    viewerDownload.hidden = false;
    viewerOpen.setAttribute('aria-pressed', String(showingOriginal));
    viewerOpen.setAttribute('aria-label', showingOriginal ? '返回优化预览' : '在当前页面查看原图');
    viewerOpen.title = showingOriginal ? '返回优化预览' : '查看原图';
  }

  /**
   * 计算图片宽高比标签（最大公约数简化；非标准比例回退为小数 x:1）
   * @param w 宽度（px）
   * @param h 高度（px）
   * @returns 形如 "3 : 2" / "1.78 : 1" 的标签，无尺寸时返回 null
   */
  function aspectRatioLabel(w: number, h: number): string | null {
    if (!w || !h || w <= 0 || h <= 0) return null;
    /** 最大公约数（欧几里得算法） */
    const gcd = (a: number, b: number): number => (b === 0 ? a : gcd(b, a % b));
    const g = gcd(w, h);
    const rw = w / g;
    const rh = h / g;
    // 简化后单项过大（非标准比例）时，用小数形式表达
    if (rw > 20 || rh > 20) return `${(w / h).toFixed(2)} : 1`;
    return `${rw} : ${rh}`;
  }

  /**
   * 文件大小格式化为人类可读文本
   * @param bytes 字节数
   * @returns "123.4 KB" / "3.50 MB"，无数据返回 null
   */
  function formatBytes(bytes: number): string | null {
    if (!bytes || bytes <= 0) return null;
    return bytes < 1024 * 1024 ? `${(bytes / 1024).toFixed(1)} KB` : `${(bytes / 1024 / 1024).toFixed(2)} MB`;
  }

  /** HTML 文本转义（元数据可能包含特殊字符） */
  function escHtml(s: string): string {
    return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  }

  /** 信息面板内容随照片切换：标题/描述持久化头部 + 基本信息（尺寸/宽高比/大小/格式）+ 允许公开的 EXIF 字段 */
  function updateInfoPanel(p: (typeof PHOTOS)[number]): void {
    // 标题 / 描述：写入持久化头部（textContent 自动转义，交互期间始终随当前照片更新）
    const titleEl = infoPanel.querySelector<HTMLElement>('.info-photo-title');
    const descEl = infoPanel.querySelector<HTMLElement>('.info-photo-desc');
    if (titleEl) titleEl.textContent = p.title || '';
    if (descEl) descEl.textContent = p.description || '';
    const hasHeading = !!(p.title || p.description);

    const rows: [string, string][] = [];
    // 基本信息
    if (p.width && p.height) {
      rows.push(['Dimensions', `${p.width} × ${p.height}`]);
      const ratio = aspectRatioLabel(p.width, p.height);
      if (ratio) rows.push(['Aspect Ratio', ratio]);
    }
    const sizeText = formatBytes(p.fileSize);
    if (sizeText) rows.push(['File Size', sizeText]);
    if (p.mimeType) rows.push(['Format', p.mimeType.replace('image/', '').toUpperCase()]);
    // EXIF（仅 API 公开字段存在时显示）
    const m = p.metadata;
    if (m['camera']) rows.push(['Camera', String(m['camera'])]);
    if (m['lens']) rows.push(['Lens', String(m['lens'])]);
    if (m['focalLength']) rows.push(['Focal Length', String(m['focalLength'])]);
    if (m['aperture']) rows.push(['Aperture', String(m['aperture'])]);
    if (m['shutterSpeed']) rows.push(['Shutter', String(m['shutterSpeed'])]);
    if (m['iso']) rows.push(['ISO', String(m['iso'])]);
    if (m['takenAt']) rows.push(['Date', String(m['takenAt'])]);
    const list = infoPanel.querySelector('.info-list');
    if (list) {
      list.innerHTML = rows
        .map(([k, v]) => `<div class="info-row"><dt>${escHtml(k)}</dt><dd>${escHtml(v)}</dd></div>`)
        .join('');
    }
    // 标题/描述与元数据均无内容时才隐藏面板并复位按钮状态
    if (rows.length === 0 && !hasHeading) {
      infoPanel.hidden = true;
      infoBtn.setAttribute('aria-pressed', 'false');
    }
  }

  /** 缩略图条高亮当前项并滚动到可见区域 */
  function updateThumbHighlight(): void {
    thumbTrack.querySelectorAll<HTMLElement>('.thumb-cell').forEach((cell) => {
      cell.classList.toggle('current', parseInt(cell.dataset.thumbIndex!, 10) === current);
    });
    const currentCell = thumbTrack.querySelector<HTMLElement>(`.thumb-cell[data-thumb-index="${current}"]`);
    currentCell?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
  }

  /** 预加载相邻两张屏幕尺寸预览（不下载相邻原图）。 */
  function preloadNeighbors(): void {
    if (!active()) return;
    for (const delta of [-1, 1]) {
      const idx = (current + delta + PHOTOS.length) % PHOTOS.length;
      const img = new Image();
      img.src = PHOTOS[idx].preview;
    }
  }

  /** 鼠标悬停缩略图时提前取对应预览，点击后通常可立即显示。 */
  document.addEventListener('pointerover', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-viewer-trigger]');
    if (!trigger) return;
    const photo = PHOTOS[parseInt(trigger.dataset.viewerTrigger!, 10)];
    if (photo) new Image().src = photo.preview;
  });

  /* ---------- 事件：列表点击 / 关闭 / 键盘 ---------- */
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-viewer-trigger]');
    if (trigger) {
      e.preventDefault();
      openViewer(parseInt(trigger.dataset.viewerTrigger!, 10));
      return;
    }
    if ((e.target as HTMLElement).closest('[data-viewer-close]')) closeViewer();
    // 缩略图条点击切换
    const thumb = (e.target as HTMLElement).closest<HTMLElement>('[data-thumb-index]');
    if (thumb) {
      const idx = parseInt(thumb.dataset.thumbIndex!, 10);
      if (idx !== current) { current = idx; render(); preloadNeighbors(); }
    }
  });

  document.addEventListener('keydown', (e) => {
    // 查看器未打开时：响应列表容器（role=button，div 无原生键盘行为）的 Enter/Space 触发
    if (viewer.hidden) {
      if (e.key === 'Enter' || e.key === ' ') {
        const trigger = (document.activeElement as HTMLElement | null)?.closest?.<HTMLElement>('[data-viewer-trigger]');
        if (trigger) {
          e.preventDefault();
          openViewer(parseInt(trigger.dataset.viewerTrigger!, 10));
        }
      }
      return;
    }
    if (e.key === 'Escape') closeViewer();
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });

  document.getElementById('viewerPrev')!.addEventListener('click', () => step(-1));
  document.getElementById('viewerNext')!.addEventListener('click', () => step(1));
  document.getElementById('viewerClose')!.addEventListener('click', closeViewer);
  viewerOpen.addEventListener('click', () => {
    const p = PHOTOS[current];
    if (p) loadViewerImage(p, !showingOriginal);
  });

  /** Info 面板开关（同步 viewer 的 info-open 类：移动端据此抬高左右切换按钮避让底部抽屉） */
  infoBtn.addEventListener('click', () => {
    infoPanel.hidden = !infoPanel.hidden;
    infoBtn.setAttribute('aria-pressed', String(!infoPanel.hidden));
    viewer.classList.toggle('info-open', !infoPanel.hidden);
  });

  /* ---------- 图片加载状态处理（§36：单图失败不破坏整体；令牌防竞态） ---------- */
  /**
   * 判断 load/error 回调是否属于当前渲染批次
   * 快速切换时旧请求的回调携带过期令牌，直接丢弃避免覆盖新照片状态
   */
  function isCurrentRender(): boolean {
    return viewerImage.dataset.token === String(renderToken);
  }

  viewerImage.addEventListener('load', () => {
    if (!isCurrentRender()) return;
    viewerImage.style.opacity = '1';
    // 目标图片淡入后隐藏缩略图/预览占位层。
    viewerPlaceholder.style.opacity = '0';
    viewerLoading.hidden = true;
    viewerFail.hidden = true;
    const p = PHOTOS[current];
    if (p) updateOpenButtons(p);
  });
  viewerImage.addEventListener('error', () => {
    if (!isCurrentRender()) return;
    viewerImage.style.opacity = '0';
    viewerLoading.hidden = true;
    viewerFail.hidden = false;
    const p = PHOTOS[current];
    if (p) updateOpenButtons(p);
  });

  /** 加载失败提示点击重试：重新触发当前显示模式的图片加载。 */
  viewerFail.addEventListener('click', () => {
    const p = PHOTOS[current];
    if (!p) return;
    viewerFail.hidden = true;
    viewerLoading.hidden = false;
    const source = showingOriginal ? p.image : p.preview;
    viewerImage.src = `${source}${source.includes('?') ? '&' : '?'}r=${Date.now()}`;
  });

  /* ---------- 鼠标滚轮缩放（§29） ---------- */
  viewerCanvas.addEventListener(
    'wheel',
    (e) => {
      if (viewer.hidden) return;
      e.preventDefault();
      // 连续滚轮期间只更新目标值；真正的样式写入每动画帧最多执行一次。
      if (wheelEndTimer == null) wheelTargetScale = scale;
      const factor = e.deltaY < 0 ? 1.15 : 1 / 1.15;
      wheelTargetScale = Math.min(SCALE_MAX, Math.max(SCALE_MIN, wheelTargetScale * factor));
      viewerImage.classList.add('is-transforming');
      if (wheelFrame == null) {
        wheelFrame = requestAnimationFrame(() => {
          wheelFrame = null;
          zoomTo(wheelTargetScale);
        });
      }
      if (wheelEndTimer != null) window.clearTimeout(wheelEndTimer);
      wheelEndTimer = window.setTimeout(() => {
        wheelEndTimer = null;
        if (!dragging) viewerImage.classList.remove('is-transforming');
      }, 140);
    },
    { passive: false }
  );

  /* ---------- 双击恢复 100%（§30） ---------- */
  viewerImage.addEventListener('dblclick', (e) => {
    e.preventDefault();
    resetZoom();
  });

  /* ---------- 缩放后拖动平移（鼠标） ---------- */
  viewerImage.addEventListener('pointerdown', (e) => {
    // 仅鼠标主键（左键）启动拖拽平移；右键/中键不捕获指针，保证原生右键菜单可用
    if (scale <= 1 || e.pointerType === 'touch' || e.button !== 0) return;
    e.preventDefault();
    dragging = true;
    dragPointerId = e.pointerId;
    dragLast = { x: e.clientX, y: e.clientY };
    viewerImage.classList.add('is-transforming');
    viewerImage.style.cursor = 'grabbing';
    viewerImage.setPointerCapture(e.pointerId);
  });
  viewerImage.addEventListener('pointermove', (e) => {
    if (!dragging || !dragLast || e.pointerId !== dragPointerId) return;
    // 即使 pointerup 因窗口切换等原因丢失，主键松开后也立即停止移动。
    if ((e.buttons & 1) === 0) {
      stopDragging(e.pointerId);
      return;
    }
    panX += e.clientX - dragLast.x;
    panY += e.clientY - dragLast.y;
    dragLast = { x: e.clientX, y: e.clientY };
    applyTransform();
  });
  function stopDragging(pointerId?: number): void {
    if (pointerId != null && dragPointerId != null && pointerId !== dragPointerId) return;
    dragging = false;
    dragPointerId = null;
    dragLast = null;
    if (wheelEndTimer == null) viewerImage.classList.remove('is-transforming');
    if (scale > 1) viewerImage.style.cursor = 'grab';
  }
  viewerImage.addEventListener('pointerup', (e) => stopDragging(e.pointerId));
  viewerImage.addEventListener('pointercancel', (e) => stopDragging(e.pointerId));
  viewerImage.addEventListener('lostpointercapture', (e) => stopDragging(e.pointerId));
  window.addEventListener('blur', () => stopDragging());

  /* ---------- 移动端：未放大时单指切图 / 放大后单指平移 / 双指缩放 ---------- */
  let touchStartX = 0;
  let touchStartY = 0;
  let touchPanLastX = 0;
  let touchPanLastY = 0;
  let touchPanning = false;
  /** 一次触摸序列中是否出现过双指，防止捏合结束被误判为左右切图。 */
  let touchGestureWasPinch = false;
  /** 双指初始距离与初始倍数 */
  let pinchStartDist = 0;
  let pinchStartScale = 1;

  viewerCanvas.addEventListener(
    'touchstart',
    (e) => {
      if (viewer.hidden) return;
      if (e.touches.length === 1) {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchPanLastX = touchStartX;
        touchPanLastY = touchStartY;
        touchPanning = scale > 1;
        if (touchPanning) viewerImage.classList.add('is-transforming');
      } else if (e.touches.length === 2) {
        touchPanning = false;
        touchGestureWasPinch = true;
        viewerImage.classList.add('is-transforming');
        pinchStartDist = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY
        );
        pinchStartScale = scale;
      }
    },
    { passive: true }
  );
  viewerCanvas.addEventListener(
    'touchmove',
    (e) => {
      if (viewer.hidden) return;
      if (e.touches.length === 2 && pinchStartDist) {
        e.preventDefault();
        const dist = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY
        );
        zoomTo(pinchStartScale * (dist / pinchStartDist));
        return;
      }
      if (e.touches.length === 1 && scale > 1 && touchPanning) {
        e.preventDefault();
        const touch = e.touches[0];
        panX += touch.clientX - touchPanLastX;
        panY += touch.clientY - touchPanLastY;
        touchPanLastX = touch.clientX;
        touchPanLastY = touch.clientY;
        applyTransform();
      }
    },
    { passive: false }
  );
  viewerCanvas.addEventListener(
    'touchend',
    (e) => {
      if (viewer.hidden) return;
      // 双指抬起一根后，剩余手指可无跳变地继续平移放大图。
      if (e.touches.length === 1) {
        pinchStartDist = 0;
        const touch = e.touches[0];
        touchPanLastX = touch.clientX;
        touchPanLastY = touch.clientY;
        touchPanning = scale > 1;
        return;
      }
      if (e.touches.length > 0) return;
      pinchStartDist = 0;
      // 单指横向滑动切换（阈值 30px 且横向明显大于纵向）
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      const shouldStep = !touchGestureWasPinch && !touchPanning && scale <= 1;
      touchPanning = false;
      touchGestureWasPinch = false;
      if (wheelEndTimer == null && !dragging) viewerImage.classList.remove('is-transforming');
      if (shouldStep && Math.abs(dx) > 30 && Math.abs(dx) > Math.abs(dy) * 1.5) step(dx > 0 ? -1 : 1);
    },
    { passive: true }
  );
  viewerCanvas.addEventListener('touchcancel', () => {
    pinchStartDist = 0;
    touchPanning = false;
    touchGestureWasPinch = false;
    if (wheelEndTimer == null && !dragging) viewerImage.classList.remove('is-transforming');
  }, { passive: true });
</script>

