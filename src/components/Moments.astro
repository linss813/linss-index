---
import {formatShanghai} from '../lib/datetime';
import { moments, type Moment } from '../services/community';
const {limit=5,items}=Astro.props;const rows:Moment[]=items||moments(limit);
---
<section class="moments"><header><h2>日常动态</h2><a href="/moments" style="font-size:12px;color:var(--color-muted)">所有日常 →</a></header>{rows.length?rows.map(row=><article><div class="moment-avatar">✦</div><div class="moment-body"><strong>日常记录 {row.pinned?'· 置顶':''}</strong><a class="moment-date" href={`/moments/${row.id}`}>{formatShanghai(row.created_at)}</a><p class:list={['moment-text',{clamped:row.content.length>300}]}>{row.content}</p>{row.content.length>300&&<button type="button" class="expand-moment" aria-expanded="false">展开全文</button>}{JSON.parse(row.images_json||'[]').length>0&&<div class:list={['moment-images',{'single':JSON.parse(row.images_json).length===1,'four':JSON.parse(row.images_json).length===4}]}>{JSON.parse(row.images_json).map((src:string)=><button type="button" class="moment-photo" data-src={src} aria-label="查看日常照片"><img src={src} alt="日常照片" loading="lazy"/></button>)}</div>}{row.link&&<a class="moment-link" href={row.link} target="_blank" rel="noopener">↗ {row.link}</a>}{row.tags&&<small>{row.tags.split(/[,，]/).filter(Boolean).map(tag=>`#${tag.trim()}`).join(' ')}</small>}<a class="conversation" href={`/moments/${row.id}#comments`}>回应这段日常 →</a></div></article>):<p class="empty">日常的片刻，会慢慢记录在这里。</p>}</section>
<style>.moments{padding:24px 0;margin:20px 0}header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--color-border);padding-bottom:14px}h2{font-size:19px}header span,.empty{color:var(--color-muted);font-size:12px}article{display:flex;gap:14px;padding:25px 0;border-bottom:1px solid var(--color-border)}.moment-avatar{background:color-mix(in srgb,var(--color-accent) 15%,var(--color-card));color:var(--color-accent);width:42px;height:42px;display:grid;place-items:center;border-radius:12px;flex-shrink:0}.moment-body{min-width:0;flex:1}.moment-body>strong{font-size:13px}.moment-date{display:block;font-size:11px;color:var(--color-muted);margin:5px 0 12px}.moment-body p{white-space:pre-wrap;line-height:1.85;font-size:15px}.moment-images{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;max-width:480px;margin:14px 0}.moment-images.four{grid-template-columns:repeat(2,1fr);max-width:340px}.moment-images.single{grid-template-columns:1fr;max-width:380px}.moment-images img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:8px}.moment-images.single img{aspect-ratio:auto;max-height:420px;object-fit:contain}.moment-link{display:block;padding:10px 13px;border-radius:8px;background:var(--color-card);border:1px solid var(--color-border);font-size:12px;overflow-wrap:anywhere;margin-top:10px}.conversation{display:block;color:var(--color-accent);font-size:12px;margin-top:14px}small{display:block;margin-top:12px;color:var(--color-muted)}.empty{padding:20px 0}</style>

<script>
document.querySelectorAll<HTMLButtonElement>('.expand-moment').forEach(
  (button) =>
    (button.onclick = () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.previousElementSibling?.classList.toggle('clamped', expanded);
      button.setAttribute('aria-expanded', String(!expanded));
      button.textContent = expanded ? '展开全文' : '收起';
    }),
);
document.querySelectorAll<HTMLElement>('.moments').forEach((section) => {
  const dialog = document.createElement('dialog');
  dialog.className = 'moment-lightbox';
  const image = document.createElement('img');
  image.alt = '日常照片预览';
  const caption = document.createElement('p');
  const close = document.createElement('button');
  close.textContent = '关闭 ✕';
  close.onclick = () => dialog.close();
  const prev = document.createElement('button');
  prev.textContent = '← 上一张';
  const next = document.createElement('button');
  next.textContent = '下一张 →';
  let photos: string[] = [],
    index = 0;
  function show() {
    image.src = photos[index];
    caption.textContent = `${index + 1} / ${photos.length}`;
    prev.disabled = index === 0;
    next.disabled = index === photos.length - 1;
  }
  prev.onclick = () => {
    index--;
    show();
  };
  next.onclick = () => {
    index++;
    show();
  };
  dialog.append(close, image, prev, caption, next);
  document.body.append(dialog);
  dialog.onkeydown = (e) => {
    if (e.key === 'ArrowLeft' && index > 0) {
      index--;
      show();
    }
    if (e.key === 'ArrowRight' && index < photos.length - 1) {
      index++;
      show();
    }
  };
  section.querySelectorAll<HTMLButtonElement>('.moment-photo').forEach(
    (button) =>
      (button.onclick = () => {
        photos = Array.from(
          button
            .closest('.moment-images')!
            .querySelectorAll<HTMLButtonElement>('.moment-photo'),
        ).map((b) => b.dataset.src!);
        index = photos.indexOf(button.dataset.src!);
        show();
        dialog.showModal();
      }),
  );
});
</script>
<style is:global>
.moment-text.clamped{display:-webkit-box;-webkit-line-clamp:6;-webkit-box-orient:vertical;overflow:hidden}.expand-moment{font-size:12px;color:var(--color-accent);margin-top:8px}.moment-photo{display:block;cursor:zoom-in;border:0;padding:0;background:none;min-width:0}.moment-lightbox{position:fixed;inset:0;margin:auto;max-width:95vw;max-height:94dvh;padding:20px;border:1px solid #697166;border-radius:14px;background:#252b25;color:#e0e5dd}.moment-lightbox::backdrop{background:#141a14df;backdrop-filter:blur(8px)}.moment-lightbox img{display:block;max-width:85vw;max-height:75dvh;object-fit:contain;margin:14px auto}.moment-lightbox button{font-size:13px;padding:8px 14px}.moment-lightbox p{display:inline-block;font-size:12px;color:#a3b09b;padding:0 20px}.moment-lightbox button:disabled{opacity:.3}
</style>
