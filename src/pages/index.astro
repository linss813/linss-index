---
/**
 * 首页（Editorial 排版结构）
 * Header → Hero → Featured（首要 / 次要入口）→ Services（分组条目）→ Footer
 *
 * 布局模式（appearance.layout.mode）：
 * - mixed（默认）：featured 服务做大字条目，display='card' 服务按分类分组网格，
 *                 display='list' 服务进入列表区块
 * - grid：全部服务按分类分组网格条目
 * - list：全部服务按分类分组列表行
 */
import {resolveHomeOrder} from '../lib/home-layout';
import Layout from '../layouts/Layout.astro';
import Moments from '../components/Moments.astro';
import HomeSidebars from '../components/HomeSidebars.astro';
import Comments from '../components/Comments.astro';
import { communitySettings } from '../services/community';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeaturedService from '../components/FeaturedService.astro';
import ServiceGroup from '../components/ServiceGroup.astro';
import Footer from '../components/Footer.astro';
import BlogSection from '../components/blog/BlogSection.astro';
import { getServices, getSiteConfig, getAppearance, getSetting } from '../lib/queries';
import { getBlogDefaultCover, getHomeArticles } from '../services/articles';
import type { Service, ServiceDisplay } from '../config/services';

/** 从数据库获取站点配置、服务列表和外观设置 */
const siteConfig = getSiteConfig();
const services = getServices();
const appearance = getAppearance();
/** 远程博客 RSS 与 Sitemap：服务层负责超时、清洗和短缓存。 */
const homeArticles = getHomeArticles();
const blogFeed = {
  title: '十三月杂记', description: '最新文章', articles: homeArticles.latest,
  sitemapAvailable: true, stale: false,
};
const blogDefaultCover = getBlogDefaultCover();

/** 获取服务显示方式（display 优先，未设置时由 featured 推断） */
function displayOf(service: Service): ServiceDisplay {
  return service.display ?? (service.featured ? 'featured' : 'card');
}

/** 按分类分组，保持配置出现顺序（空分类自然不会出现） */
function groupByCategory(list: Service[]): { category: string; services: Service[] }[] {
  return [...new Set(list.map((s) => s.category))].map((category) => ({
    category,
    services: list.filter((s) => s.category === category)
  }));
}

const mode = appearance.layout.mode;

/** mixed 模式下的三个区域数据 */
const featuredServices =
  mode === 'mixed' ? services.filter((s) => displayOf(s) === 'featured') : [];
const cardGroups = groupByCategory(
  mode === 'mixed'
    ? services.filter((s) => displayOf(s) === 'card')
    : mode === 'grid'
      ? services
      : []
);
const otherServices = mode === 'mixed' ? services.filter((s) => displayOf(s) === 'list') : [];
/** list 模式：全部服务按分类分组为列表行 */
const listGroups = mode === 'list' ? groupByCategory(services) : [];
const utilityTools = [
  { id: 'json', name: 'JSON 格式化', description: '校验、美化或压缩 JSON 数据', mark: '{ }' },
  { id: 'timestamp', name: '时间戳转换', description: '秒、毫秒与日期时间互转', mark: 'T' },
  { id: 'base64', name: 'Base64', description: '支持中文的 Base64 编解码', mark: '64' },
  { id: 'url', name: 'URL 编解码', description: '处理 URL 参数中的特殊字符', mark: '%' },
];

/** 区块编号：Featured 固定为 01，其余区块从 02 连续递增 */
let sectionIndex = 1;
const homeOrder=resolveHomeOrder(getSetting('home_module_order',''));
---

<Layout>
  <Header />
  <Hero />
  <main>
    {homeOrder.map(module=><div class="home-module" data-home-module={module}>
      {module==='writing'&&<>
    <BlogSection feed={blogFeed} pinned={homeArticles.pinned} defaultCover={blogDefaultCover} index={sectionIndex++} />
      </>}
      {module==='featured'&&<>
    {
      featuredServices.length > 0 && (
        <section class="container featured" aria-labelledby="featured-title">
          <h2 class="group-head" id="featured-title">
            <span class="group-index">{String(sectionIndex++).padStart(2,'0')}</span>
            <span>{siteConfig.sections.featured}</span>
          </h2>
          <div class="featured-list">
            {featuredServices.map((service, i) => (
              <FeaturedService service={service} major={i === 0} />
            ))}
          </div>
        </section>
      )
    }

      </>}
      {module==='services'&&<>
    {cardGroups.map((group) => (
      <ServiceGroup
        category={group.category}
        services={group.services}
        index={sectionIndex++}
        variant="card"
      />
    ))}

    {
      otherServices.length > 0 && (
        <ServiceGroup
          category={siteConfig.sections.otherServices}
          services={otherServices}
          index={sectionIndex++}
          variant="list"
        />
      )
    }

    {listGroups.map((group) => (
      <ServiceGroup
        category={group.category}
        services={group.services}
        index={sectionIndex++}
        variant="list"
      />
    ))}

      </>}
      {module==='tools'&&<>
    <section class="container tools-preview" aria-labelledby="tools-title">
      <div class="tools-heading">
        <h2 class="group-head" id="tools-title">
          <span class="group-index">{String(sectionIndex++).padStart(2, '0')}</span>
          <span>便捷工具</span>
        </h2>
        <a href="/tools">全部工具 <span aria-hidden="true">→</span></a>
      </div>
      <div class="tools-grid">
        {utilityTools.map((tool) => (
          <a class="tool-entry" href={`/tools#${tool.id}`}>
            <span class="tool-mark" aria-hidden="true">{tool.mark}</span>
            <span><strong>{tool.name}</strong><small>{tool.description}</small></span>
          </a>
        ))}
      </div>
    </section>


      </>}
      {module==='moments'&&<>
  {communitySettings().home && <div class="container"><Moments limit={communitySettings().limit}/></div>}
      </>}
      {module==='guestbook'&&<>
  <div class="container" id="guestbook"><Comments/></div>
      </>}
    </div>)}
  </main>
  <HomeSidebars document={Astro.props.sidebarPreview}/>
  <Footer />
</Layout>

<style>
  main {
    padding-bottom: calc(var(--space-section) * 0.6);
  }

  .featured {
    margin-bottom: var(--space-section);
  }

  /* Featured 区头与分组区头共用同一组样式 */
  .group-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }

  .group-index {
    color: var(--color-accent);
  }

  .tools-preview { margin-bottom: var(--space-section); }
  .tools-heading { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:18px; }
  .tools-heading .group-head { margin-bottom:0; }
  .tools-heading > a { color:var(--color-muted); font-family:var(--font-mono); font-size:.75rem; }
  .tools-heading > a:hover { color:var(--color-accent); }
  .tools-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); border-top:1px solid var(--color-border); }
  .tool-entry { display:grid; grid-template-columns:48px minmax(0,1fr); gap:16px; align-items:center; padding:22px 18px 22px 0; border-bottom:1px solid var(--color-border); }
  .tool-entry:nth-child(odd) { border-right:1px solid var(--color-border); }
  .tool-entry:nth-child(even) { padding-left:18px; }
  .tool-entry:hover strong { color:var(--color-accent); }
  .tool-mark { display:grid; width:42px; height:42px; place-items:center; border:1px solid var(--color-border); border-radius:10px; color:var(--color-accent); font-family:var(--font-mono); font-size:.78rem; }
  .tool-entry strong,.tool-entry small { display:block; }
  .tool-entry strong { font-size:.95rem; transition:color var(--transition-fast); }
  .tool-entry small { margin-top:3px; color:var(--color-muted); font-size:.78rem; }
  @media(max-width:640px){.tools-grid{grid-template-columns:1fr}.tool-entry:nth-child(odd){border-right:0}.tool-entry:nth-child(even){padding-left:0}}
</style>
