---
import Icon from '../../components/Icon.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminUrl } from '../../lib/admin-path';
---
<AdminLayout title="首页功能栏" active="sidebars"><div class="builder-head"><div><small>HOME / WIDGETS</small><h1>编排你的首页侧栏</h1><p>让内容、入口与交流各有位置。</p></div><div class="builder-actions"><span id="saveState" role="status">正在载入…</span><button id="saveDraft" class="btn-secondary">保存草稿</button><button id="publish" class="btn-primary">应用到首页</button></div></div><div class="builder"><aside class="module-list"><header><h2>模块</h2><button id="add" class="btn-icon">＋ 添加</button></header><div id="moduleList"></div><label class="width-label">侧栏宽度<select id="width"><option value="180">紧凑 · 180px</option><option value="220">标准 · 220px</option><option value="260">宽松 · 260px</option></select></label><details><summary>历史版本</summary><div id="history"></div></details></aside><section class="properties"><header><h2 id="propertyTitle">模块属性</h2><button id="remove" class="btn-icon danger">删除</button></header><form id="properties"></form></section><section class="preview"><header><h2>内容预览</h2><div><button id="refreshPreview" class="btn-icon">刷新预览</button><a href={adminUrl('/sidebar-preview')} target="_blank" class="btn-icon">独立预览 ↗</a></div></header><p>修改即时预览，保存草稿不会影响已发布首页。</p><div class="preview-frame"><iframe name="sidebarPreview" id="preview" src={adminUrl('/sidebar-preview')} title="侧栏预览"></iframe></div></section></div><dialog id="templates"><header><h2>选择模块模板</h2><button id="closeTemplates" class="btn-icon">关闭</button></header><div id="templateList"></div></dialog><template id="sidebarIconCatalog">{['book-open','folder','image','server','music','globe','terminal','github','mail','video','zap','activity'].map(name=><button type="button" data-icon={name} title={name}><Icon name={name}/><span>{name}</span></button>)}</template></AdminLayout>
<script>
import BlockEditor from '../../lib/block-editor';
import type { SidebarDocument, SidebarModule } from '../../services/sidebars';
const $ = (id: string) => document.getElementById(id)!;
const names: Record<SidebarModule['kind'], string> = {
  profile: '站点介绍',
  links: '快捷入口',
  articles: '最近文章',
  moments: '日常动态',
  guestbook: '留言墙',
  stats: '站点统计',
  ad: '图片推广',
  text: '自定义文字',
};
let propertyEditor: BlockEditor | undefined;
let documentData: SidebarDocument,
  selected = '',
  dirty = false,
  busy = false,
  dragged = '';
let published: SidebarDocument;
let undo: SidebarModule | undefined;
let editGeneration = 0;
let previewTimer = 0,
  previewMode = 'cards',
  viewportWidth = 768;
function mark() {
  editGeneration++;
  dirty = true;
  $('saveState').textContent = '有未保存的修改';
  clearTimeout(previewTimer);
  previewTimer = window.setTimeout(preview, 400);
}
const selectedModule = () =>
  documentData.modules.find((m) => m.id === selected);
function makeButton(label: string, fn: () => void) {
  const b = document.createElement('button');
  b.type = 'button';
  b.textContent = label;
  b.onclick = fn;
  return b;
}
function move(id: string, offset: number) {
  const list = documentData.modules;
  const index = list.findIndex((m) => m.id === id);
  const side = list[index].side;
  const peers = list.filter((m) => m.side === side);
  const target = peers[peers.findIndex((m) => m.id === id) + offset];
  if (!target) return;
  const dest = list.indexOf(target);
  [list[index], list[dest]] = [list[dest], list[index]];
  mark();
  renderList();
}
function renderList() {
  $('moduleList').replaceChildren();
  for (const side of ['left', 'right'] as const) {
    const group = document.createElement('section');
    const h = document.createElement('h3');
    h.textContent = side === 'left' ? '左侧 · 导航与内容' : '右侧 · 日常与互动';
    group.append(h);
    for (const m of documentData.modules.filter((m) => m.side === side)) {
      const row = document.createElement('div');
      row.className = `module-row ${m.id === selected ? 'selected' : ''} ${!m.enabled ? 'disabled' : ''}`;
      row.draggable = true;
      row.ondragstart = () => (dragged = m.id);
      row.ondragover = (e) => {
        e.preventDefault();
        row.classList.add('drop-target');
      };
      row.ondragleave = () => row.classList.remove('drop-target');
      row.ondrop = (e) => {
        e.preventDefault();
        row.classList.remove('drop-target');
        const source = documentData.modules.find((v) => v.id === dragged);
        if (!source || source === m) return;
        documentData.modules = documentData.modules.filter((v) => v !== source);
        source.side = m.side;
        documentData.modules.splice(documentData.modules.indexOf(m), 0, source);
        mark();
        renderList();
        renderProperties();
      };
      const title = makeButton(`${m.enabled ? '●' : '○'} ${m.title}`, () => {
        selected = m.id;
        renderList();
        renderProperties();
        ($('preview') as HTMLIFrameElement).contentWindow?.postMessage(
          { selected },
          location.origin,
        );
      });
      title.className = 'module-title';
      const hint = document.createElement('small');
      hint.textContent = names[m.kind];
      const controls = document.createElement('div');
      controls.className = 'row-controls';
      controls.append(
        makeButton('↑', () => move(m.id, -1)),
        makeButton('↓', () => move(m.id, 1)),
        makeButton('⇄', () => {
          m.side = m.side === 'left' ? 'right' : 'left';
          mark();
          renderList();
          renderProperties();
        }),
        makeButton('复制', () => {
          if (documentData.modules.length >= 16) return;
          documentData.modules.push({
            ...structuredClone(m),
            id: crypto.randomUUID(),
            title: m.title + ' 副本',
          });
          mark();
          renderList();
        }),
      );
      row.append(title, hint, controls);
      group.append(row);
    }
    $('moduleList').append(group);
  }
}
function field(
  label: string,
  key: 'title' | 'content' | 'url' | 'image' | 'profileName' | 'imageAlt',
  multiline = false,
) {
  const m = selectedModule()!;
  const wrap = document.createElement('label');
  wrap.textContent = label;
  const el = document.createElement(multiline ? 'textarea' : 'input');
  el.value = m[key] || '';
  el.oninput = () => {
    m[key] = el.value;
    mark();
    if (key === 'title') renderList();
  };
  wrap.append(el);
  $('properties').append(wrap);
}
function renderProperties() {
  const root = $('properties');
  propertyEditor?.editor.destroy();
  propertyEditor = undefined;
  root.replaceChildren();
  const m = selectedModule();
  $('remove').hidden = !m;
  if (!m) {
    root.textContent = '从左侧选择模块，或添加新模块。';
    return;
  }
  $('propertyTitle').textContent = names[m.kind];
  field('卡片标题', 'title');
  if (m.kind === 'profile') field('显示名称', 'profileName');
  if (['profile', 'ad'].includes(m.kind)) field('图片替代文字', 'imageAlt');
  const mobileOrder = document.createElement('input');
  mobileOrder.type = 'number';
  mobileOrder.min = '0';
  mobileOrder.max = '100';
  mobileOrder.value = String(m.order || 0);
  const orderLabel = document.createElement('label');
  orderLabel.textContent = '移动端顺序（越小越靠前）';
  orderLabel.append(mobileOrder);
  mobileOrder.oninput = () => {
    m.order = Number(mobileOrder.value);
    mark();
  };
  root.append(orderLabel);
  for (const [key, label] of [
    ['enabled', '在首页显示'],
    ['desktop', '桌面显示'],
    ['tablet', '平板显示'],
    ['mobile', '手机端显示'],
  ] as const) {
    const wrap = document.createElement('label');
    wrap.className = 'check';
    const box = document.createElement('input');
    box.type = 'checkbox';
    box.checked = m[key] !== false;
    box.onchange = () => {
      m[key] = box.checked;
      mark();
      renderList();
    };
    wrap.append(box, label);
    root.append(wrap);
  }
  if (m.kind === 'text') {
    const host = document.createElement('div');
    host.className = 'card-text-editor';
    root.append(host);
    propertyEditor = new BlockEditor({ el: host });
    if (m.contentHtml) propertyEditor.setHTML(m.contentHtml);
    else propertyEditor.setMarkdown(m.content);
    propertyEditor.on('change', () => {
      m.content = propertyEditor!.getMarkdown();
      m.contentHtml = propertyEditor!.getHTML();
      mark();
    });
  } else if (['profile', 'ad'].includes(m.kind))
    field('内容说明', 'content', true);
  if (['profile', 'ad'].includes(m.kind)) {
    field('图片地址（站内或HTTP/S）', 'image');
    const upload = document.createElement('input');
    upload.type = 'file';
    upload.accept = 'image/jpeg,image/png,image/webp,image/gif';
    upload.setAttribute('aria-label', '上传卡片图片');
    upload.onchange = async () => {
      const file = upload.files?.[0];
      if (!file) return;
      const data = new FormData();
      data.append('file', file);
      try {
        $('saveState').textContent = '正在上传图片…';
        const r = await fetch('/api/admin/media', {
          method: 'POST',
          body: data,
        });
        const result = await r.json();
        if (!r.ok) throw Error(result.error);
        m.image = result.url;
        mark();
        renderProperties();
      } catch (e) {
        $('saveState').textContent = (e as Error).message;
      }
    };
    root.append(upload);
    root.append(
      makeButton('从媒体库选择', async () => {
        try {
          const r = await fetch('/api/admin/media');
          if (!r.ok) throw Error('媒体库读取失败');
          const files = await r.json();
          const dialog = document.createElement('dialog');
          dialog.className = 'media-picker';
          const close = makeButton('关闭', () => dialog.close());
          dialog.append(close);
          for (const file of files) {
            const choose = makeButton('', () => {
              m.image = file.url;
              mark();
              renderProperties();
              dialog.close();
            });
            const image = document.createElement('img');
            image.src = file.url;
            image.alt = file.name;
            choose.append(image);
            dialog.append(choose);
          }
          if (!files.length) dialog.append('暂无图片，可先上传。');
          dialog.onclose = () => dialog.remove();
          document.body.append(dialog);
          dialog.showModal();
        } catch (e) {
          $('saveState').textContent = (e as Error).message;
        }
      }),
    );
  }
  if (['profile', 'text', 'ad'].includes(m.kind))
    field('跳转地址（选填）', 'url');
  if (m.kind === 'stats') {
    for (const name of ['文章', '动态', '留言'] as const) {
      const label = document.createElement('label');
      label.className = 'check';
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.checked = !m.metrics || m.metrics.includes(name);
      box.onchange = () => {
        const metrics = new Set<'文章' | '动态' | '留言'>(
          m.metrics || ['文章', '动态', '留言'],
        );
        if (box.checked) metrics.add(name);
        else metrics.delete(name);
        m.metrics = [...metrics];
        mark();
      };
      label.append(box, name);
      root.append(label);
    }
  }
  if (m.kind === 'articles') {
    const thumbnail = document.createElement('input');
    thumbnail.type = 'checkbox';
    thumbnail.checked = !!m.thumbnail;
    const label = document.createElement('label');
    label.className = 'check';
    label.append(thumbnail, '显示文章缩略图');
    thumbnail.onchange = () => {
      m.thumbnail = thumbnail.checked;
      mark();
    };
    root.append(label);
    const select = document.createElement('select');
    select.setAttribute('aria-label', '文章排序');
    for (const [value, label] of [
      ['published', '最近发布'],
      ['updated', '最近更新'],
    ]) {
      const option = document.createElement('option');
      option.value = value;
      option.textContent = label;
      select.append(option);
    }
    select.value = m.sort || 'published';
    select.onchange = () => {
      m.sort = select.value as 'published' | 'updated';
      mark();
    };
    root.append(select);
  }
  if (['articles', 'moments', 'guestbook'].includes(m.kind)) {
    const wrap = document.createElement('label');
    wrap.textContent = '展示条数';
    const input = document.createElement('input');
    input.type = 'number';
    input.min = '1';
    input.max = '6';
    input.value = String(m.limit);
    input.oninput = () => {
      m.limit = Number(input.value);
      mark();
    };
    wrap.append(input);
    root.append(wrap);
  }
  if (m.kind === 'links' || m.kind === 'profile') {
    const h = document.createElement('h3');
    h.textContent = '入口列表';
    root.append(h);
    m.links.forEach((link, index) => {
      const row = document.createElement('div');
      row.className = 'link-editor';
      for (const key of ['name', 'url', 'icon'] as const) {
        const input = document.createElement('input');
        input.value = link[key];
        input.placeholder = {
          name: '入口名称',
          url: '地址',
          icon: '图标名，如 image',
        }[key];
        input.oninput = () => {
          link[key] = input.value;
          mark();
        };
        row.append(input);
      }
      row.append(makeButton('选择图标', () => chooseIcon(link)));
      row.append(
        makeButton('↑', () => {
          if (index > 0) {
            [m.links[index - 1], m.links[index]] = [
              m.links[index],
              m.links[index - 1],
            ];
            mark();
            renderProperties();
          }
        }),
      );
      row.append(
        makeButton('移除', () => {
          m.links.splice(index, 1);
          mark();
          renderProperties();
        }),
      );
      root.append(row);
    });
    root.append(
      makeButton('＋ 添加入口', () => {
        m.links.push({ name: '新入口', url: '/blog', icon: 'globe' });
        mark();
        renderProperties();
      }),
    );
  }
}
function chooseIcon(link: { icon: string }) {
  const dialog = document.createElement('dialog');
  dialog.className = 'media-picker';
  const search = document.createElement('input');
  search.placeholder = '搜索图标，如 book、image、mail';
  search.style.width = '100%';
  const close = makeButton('关闭', () => dialog.close());
  const grid = document.createElement('div');
  grid.className = 'sidebar-icon-grid';
  grid.append(
    ($('sidebarIconCatalog') as HTMLTemplateElement).content.cloneNode(true),
  );
  grid.querySelectorAll<HTMLButtonElement>('[data-icon]').forEach(
    (button) =>
      (button.onclick = () => {
        link.icon = button.dataset.icon!;
        mark();
        renderProperties();
        dialog.close();
      }),
  );
  search.oninput = () =>
    grid
      .querySelectorAll<HTMLButtonElement>('button')
      .forEach(
        (button) =>
          (button.hidden = !button.dataset.icon?.includes(
            search.value.toLowerCase(),
          )),
      );
  dialog.append(close, search, grid);
  document.body.append(dialog);
  dialog.onclose = () => dialog.remove();
  dialog.showModal();
}
function preview() {
  if (!documentData) return;
  const frame = $('preview') as HTMLIFrameElement;
  const form = document.createElement('form');
  form.method = 'POST';
  form.action = frame.src.split('?')[0];
  form.target = 'sidebarPreview';
  form.hidden = true;
  const input = document.createElement('input');
  input.name = 'document';
  input.value = JSON.stringify(documentData);
  const mode = document.createElement('input');
  mode.name = 'mode';
  mode.value = previewMode;
  form.append(input, mode);
  document.body.append(form);
  form.submit();
  form.remove();
  frame.onload = () =>
    frame.contentWindow?.postMessage({ selected }, location.origin);
}
async function save(action: 'save' | 'publish') {
  if (busy) return;
  busy = true;
  const generation = editGeneration;
  const snapshot = structuredClone(documentData);
  try {
    $('saveState').textContent = '正在保存…';
    const r = await fetch('/api/admin/sidebar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action, document: snapshot }),
    });
    const data = await r.json();
    if (!r.ok) throw Error(data.error);
    if (editGeneration === generation) {
      documentData = data.document;
      dirty = false;
    } else {
      documentData.revision = data.document.revision;
      dirty = true;
    }
    if (action === 'publish') published = structuredClone(data.document);
    $('saveState').textContent =
      action === 'publish'
        ? '已应用到首页'
        : '草稿已保存 · ' + new Date().toLocaleTimeString();
    if (dirty) $('saveState').textContent += ' · 仍有新修改未保存';
    preview();
  } catch (e) {
    $('saveState').textContent = (e as Error).message;
  } finally {
    busy = false;
  }
}
for (const [label, mode] of [
  ['卡片', 'cards'],
  ['真实首页', 'home'],
])
  document.querySelector('.preview header>div')?.append(
    makeButton(label, () => {
      previewMode = mode;
      preview();
    }),
  );
function sizePreview() {
  const frame = $('preview') as HTMLIFrameElement;
  const scale = Math.min(1, frame.parentElement!.clientWidth / viewportWidth);
  frame.style.cssText = `width:${viewportWidth}px;max-width:none;height:${650 / scale}px;transform:scale(${scale});transform-origin:top left`;
}
new ResizeObserver(sizePreview).observe($('preview').parentElement!);
for (const [label, width] of [
  ['桌面', 1440],
  ['平板', 768],
  ['手机', 390],
] as const) {
  const button = makeButton(label, () => {
    viewportWidth = width;
    sizePreview();
  });
  document.querySelector('.preview header>div')?.append(button);
}
$('saveDraft').onclick = () => save('save');
$('publish').onclick = () => {
  const previous = new Map(
    published.modules.map((m) => [m.id, JSON.stringify(m)]),
  );
  const added = documentData.modules.filter((m) => !previous.has(m.id)).length;
  const changed = documentData.modules.filter(
    (m) => previous.has(m.id) && previous.get(m.id) !== JSON.stringify(m),
  ).length;
  const removed = published.modules.filter(
    (m) => !documentData.modules.some((n) => n.id === m.id),
  ).length;
  if (
    confirm(
      `将应用到首页：新增 ${added}，修改 ${changed}，移除 ${removed} 个模块。是否应用？`,
    )
  )
    void save('publish');
};
$('refreshPreview').onclick = preview;
$('width').onchange = () => {
  documentData.width = Number(($('width') as HTMLSelectElement).value) as
    180 | 220 | 260;
  mark();
};
$('properties').onsubmit = (e) => e.preventDefault();
$('remove').onclick = () => {
  const m = selectedModule();
  if (!m) return;
  undo = structuredClone(m);
  documentData.modules = documentData.modules.filter((v) => v.id !== m.id);
  selected = '';
  mark();
  renderList();
  renderProperties();
  const restore = makeButton('撤销删除', () => {
    if (undo) {
      documentData.modules.push(undo);
      undo = undefined;
      mark();
      renderList();
      restore.remove();
    }
  });
  $('saveState').append(restore);
};
const views = document.createElement('nav');
views.className = 'builder-views';
for (const [name, label] of [
  ['module-list', '模块列表'],
  ['properties', '属性编辑'],
  ['preview', '预览'],
])
  views.append(
    makeButton(label, () => {
      $('moduleList').closest('.builder')!.setAttribute('data-view', name);
    }),
  );
document.querySelector('.builder')?.before(views);
document.querySelector('.builder')?.setAttribute('data-view', 'module-list');
const dialog = $('templates') as HTMLDialogElement;
$('add').onclick = () => dialog.showModal();
$('closeTemplates').onclick = () => dialog.close();
for (const [kind, name] of Object.entries(names)) {
  const button = makeButton(name, () => {
    if (documentData.modules.length >= 16) return;
    const side = selectedModule()?.side || 'left';
    const m: SidebarModule = {
      id: crypto.randomUUID(),
      kind: kind as SidebarModule['kind'],
      title: name,
      side,
      enabled: true,
      mobile: !['ad', 'stats'].includes(kind),
      content: kind === 'profile' ? '记录日常，分享微小的发现。' : '',
      url: '',
      image: '',
      limit: kind === 'moments' ? 2 : 3,
      links:
        kind === 'links'
          ? [
              { name: '实用工具', url: '/tools', icon: 'terminal' },
              { name: '照片相册', url: '/gallery', icon: 'image' },
            ]
          : [],
    };
    documentData.modules.push(m);
    selected = m.id;
    mark();
    renderList();
    renderProperties();
    dialog.close();
  });
  const description = document.createElement('small');
  description.textContent = (
    {
      profile: '头像、简介和社交入口',
      links: '图标与名称组成的快捷网格',
      articles: '真实文章列表，支持更新排序',
      moments: '最新文字、日期与照片',
      guestbook: '已审核的独立留言摘要',
      stats: '实际公开数据统计',
      ad: '图片、说明与推广标识',
      text: '自定义格式文字与链接',
    } as Record<string, string>
  )[kind];
  button.append(description);
  $('templateList').append(button);
}
window.addEventListener('beforeunload', (e) => {
  if (dirty) e.preventDefault();
});
fetch('/api/admin/sidebar')
  .then(async (r) => {
    if (!r.ok) throw Error('读取失败，请重新登录');
    const state = await r.json();
    documentData = state.draft;
    published = state.published;
    ($('width') as HTMLSelectElement).value = String(documentData.width);
    selected = documentData.modules[0]?.id || '';
    renderList();
    renderProperties();
    $('saveState').textContent = state.warnings?.length
      ? state.warnings.join(' ')
      : '草稿与配置已载入';
    for (const item of state.history) {
      $('history').append(
        makeButton(
          new Date(item.time).toLocaleString() + ' · 恢复为草稿',
          () => {
            const revision = documentData.revision;
            documentData = structuredClone(item.document);
            documentData.revision = revision;
            mark();
            renderList();
            renderProperties();
          },
        ),
      );
    }
  })
  .catch((e) => ($('saveState').textContent = e.message));
</script>
