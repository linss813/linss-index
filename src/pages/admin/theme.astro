---
/**
 * Theme 主题管理页
 * 展示全部主题色板，支持切换激活主题 / 编辑 Light & Dark 色板
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="主题" active="theme">
  <div class="toolbar">
    <p class="hint">点击主题卡片可切换为当前激活主题，点击"编辑"可修改色板配色。</p>
  </div>

  <!-- 主题卡片容器（由脚本动态渲染） -->
  <div class="theme-grid" id="themeGrid"></div>

  <!-- 编辑色板弹窗 -->
  <div class="modal" id="modal">
    <div class="modal-content">
      <h2 class="modal-title" id="modalTitle">编辑主题</h2>
      <form id="themeForm">
        <input type="hidden" id="editThemeName" value="" />
        <div class="color-section">
          <p class="color-section-title">Light 浅色</p>
          <div id="lightColors"></div>
        </div>
        <div class="color-section">
          <p class="color-section-title">Dark 深色</p>
          <div id="darkColors"></div>
        </div>
        <div class="form-actions">
          <button type="button" class="btn-cancel" id="btnCancel">取消</button>
          <button type="submit" class="btn-primary">保存</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 主题实时预览弹窗：模拟前台实际渲染效果 -->
  <div class="modal" id="previewModal">
    <div class="modal-content">
      <div class="preview-modal-head">
        <h2 class="modal-title" id="previewTitle">主题预览</h2>
        <div class="mode-tabs">
          <button type="button" class="mode-tab active" data-mode="light">浅色 Light</button>
          <button type="button" class="mode-tab" data-mode="dark">深色 Dark</button>
        </div>
      </div>
      <div class="theme-preview" id="themePreview"></div>
      <p class="field-hint">预览模拟前台页面的实际渲染效果：背景、文字、强调色、卡片与边框均取自当前主题色板。</p>
      <div class="form-actions">
        <button type="button" class="btn-cancel" id="btnPreviewClose">关闭</button>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .toolbar { margin-bottom: 12px; padding: 11px 14px; border: 1px solid var(--admin-border); border-radius: 10px; background: #fff; }
  .hint { font-size: 0.775rem; color: var(--admin-muted); }
  .theme-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .theme-card {
    background: var(--admin-bg);
    border: 1px solid var(--admin-border);
    border-radius: 11px;
    padding: 14px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .theme-card:hover {
    border-color: var(--admin-primary);
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }
  .theme-card.active {
    border-color: var(--admin-primary);
    box-shadow: 0 0 0 1px var(--admin-primary);
  }
  .theme-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 9px;
  }
  .theme-name { font-size: 1rem; font-weight: 600; }
  .badge-current {
    background: var(--admin-primary);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .palette-preview {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 10px;
  }
  .palette-block {
    border: 1px solid var(--admin-border);
    border-radius: 8px;
    padding: 8px;
  }
  .palette-title {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--admin-muted);
    display: block;
    margin-bottom: 5px;
  }
  .palette-bg {
    height: 18px;
    border-radius: 4px;
    border: 1px solid var(--admin-border);
    margin-bottom: 5px;
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }
  .swatch-item { text-align: center; min-width: 0; }
  .swatch {
    width: 100%;
    height: 22px;
    border-radius: 4px;
    border: 1px solid rgba(0,0,0,0.12);
  }
  .swatch-label {
    font-size: 0.62rem;
    color: var(--admin-muted);
    display: block;
    margin-top: 2px;
  }
  /* 色值文本：超长截断，悬停 title 显示完整值 */
  .swatch-value {
    display: block;
    font-size: 0.55rem;
    font-family: monospace;
    color: var(--admin-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .theme-actions { display: flex; gap: 6px; flex-wrap: wrap; }
  .btn-primary {
    padding: 8px 16px; background: var(--admin-primary); color: #fff;
    border: none; border-radius: 8px; font-size: 0.875rem; font-weight: 600;
    cursor: pointer; transition: opacity 0.15s;
  }
  .btn-primary:hover { opacity: 0.9; }
  .btn-cancel {
    padding: 8px 16px; background: transparent; color: var(--admin-muted);
    border: 1px solid var(--admin-border); border-radius: 8px; font-size: 0.875rem;
    cursor: pointer;
  }
  /* 弹窗通用（编辑色板 + 主题预览共用） */
  .modal {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4);
    z-index: 200; align-items: center; justify-content: center;
  }
  .modal.show { display: flex; }
  .modal-content {
    width: 780px; max-width: calc(100vw - 32px); background: var(--admin-bg);
    border-radius: 12px; padding: 22px; max-height: 90vh; overflow-y: auto;
  }
  .modal-title { font-size: 1.05rem; font-weight: 600; margin-bottom: 14px; }
  #themeForm { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  #themeForm > input, #themeForm > .form-actions { grid-column: 1 / -1; }
  .color-section { min-width: 0; margin-bottom: 0; padding: 12px; border: 1px solid var(--admin-border); border-radius: 10px; }
  .color-section-title {
    font-size: 0.8125rem; font-weight: 600; margin-bottom: 10px;
    padding-bottom: 6px; border-bottom: 1px solid var(--admin-border);
  }
  .color-row { margin-bottom: 7px; }
  .color-row label {
    display: block; font-size: 0.75rem; color: var(--admin-muted); margin-bottom: 4px;
  }
  .color-inputs { display: flex; gap: 8px; align-items: center; }
  .color-picker {
    width: 44px; height: 36px; padding: 2px;
    border: 1px solid var(--admin-border); border-radius: 6px;
    cursor: pointer; background: var(--admin-bg);
  }
  .color-picker:disabled { opacity: 0.4; cursor: not-allowed; }
  .color-text {
    flex: 1; padding: 8px 10px; border: 1px solid var(--admin-border);
    border-radius: 6px; font-size: 0.8125rem; font-family: monospace;
  }
  .color-text:focus { outline: none; border-color: var(--admin-primary); }
  /* 主题预览弹窗 */
  .preview-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .preview-modal-head .modal-title { margin-bottom: 0; }
  .mode-tabs { display: flex; gap: 6px; }
  .mode-tab {
    padding: 5px 12px; font-size: 0.75rem; border: 1px solid var(--admin-border);
    border-radius: 999px; background: var(--admin-bg); color: var(--admin-muted);
    cursor: pointer; transition: all 0.15s;
  }
  .mode-tab:hover { color: var(--admin-primary); border-color: var(--admin-primary); }
  .mode-tab.active { background: var(--admin-primary); color: #fff; border-color: var(--admin-primary); }
  .theme-preview { margin-bottom: 4px; }
  .form-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
  @media (max-width: 1280px) { .theme-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 820px) { .theme-grid { grid-template-columns: 1fr; } #themeForm { grid-template-columns: 1fr; } #themeForm > .form-actions { grid-column: auto; } }
  @media (max-width: 520px) { .palette-preview { grid-template-columns: 1fr; } .modal-content { padding: 16px; } .theme-actions .btn-icon { flex: 1; justify-content: center; } }
</style>

<script>
  // 主题数据与当前激活主题名（模块级状态）
  let themesData: any[] = [];
  let activeTheme = 'default';

  /** 操作按钮内联 SVG 图标（feather 风格，继承按钮文字颜色） */
  const ICONS: Record<string, string> = {
    eye: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>',
    edit: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>',
    check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>',
  };

  // 色板全部字段（编辑弹窗中使用 6 个字段）
  const COLOR_KEYS = ['background', 'foreground', 'muted', 'accent', 'card', 'border'] as const;
  // 色板字段中文标签
  const COLOR_LABELS: Record<string, string> = {
    background: '背景 background',
    foreground: '前景 foreground',
    muted: '次要 muted',
    accent: '强调 accent',
    card: '卡片 card',
    border: '边框 border',
  };
  // 颜色展示模块：全部 6 个色板字段（中文名 + 色值一览）
  const PREVIEW_KEYS = [
    { key: 'background', label: '背景' },
    { key: 'foreground', label: '文字' },
    { key: 'muted', label: '次要' },
    { key: 'accent', label: '强调' },
    { key: 'card', label: '卡片' },
    { key: 'border', label: '边框' },
  ];

  const grid = document.getElementById('themeGrid')!;
  const modal = document.getElementById('modal')!;
  const modalTitle = document.getElementById('modalTitle')!;
  const form = document.getElementById('themeForm') as HTMLFormElement;

  /**
   * HTML 转义，防止注入
   * @param s 原始值
   * @returns 转义后的安全字符串
   */
  function esc(s: any): string {
    return String(s ?? '').replace(/[<>&"]/g, (c) => ({
      '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;',
    }[c]!));
  }

  /**
   * 过滤为安全的 CSS 颜色值，仅允许颜色相关字符
   * @param s 原始颜色值
   * @returns 安全的 CSS 颜色字符串
   */
  function safeColor(s: any): string {
    const v = String(s ?? '');
    if (/^[#a-zA-Z0-9(),\s.%-]+$/.test(v)) return v;
    return 'transparent';
  }

  /**
   * 将颜色值缩短为适合展示的文本（超过 14 字符截断加省略号）
   * @param s 原始颜色值
   * @returns 短色值文本
   */
  function shortColor(s: any): string {
    const v = String(s ?? '').trim();
    return v.length > 14 ? v.slice(0, 13) + '…' : (v || '—');
  }

  /**
   * 将颜色值标准化为 6 位 hex（#rrggbb），用于 color picker
   * @param s 颜色字符串
   * @returns 标准 hex 或 null（非 hex 格式）
   */
  function toHex6(s: string): string | null {
    const m3 = /^#([0-9a-fA-F]{3})$/.exec(s);
    if (m3) {
      return '#' + m3[1].split('').map((c) => c + c).join('').toLowerCase();
    }
    if (/^#[0-9a-fA-F]{6}$/.test(s)) return s.toLowerCase();
    return null;
  }

  /**
   * 加载全部主题与当前激活主题名，并触发渲染
   */
  async function loadThemes(): Promise<void> {
    const res = await fetch('/api/admin/theme');
    const data = await res.json();
    themesData = data.themes || [];
    activeTheme = data.activeTheme || 'default';
    renderThemes();
  }

  /**
   * 渲染主题卡片列表
   */
  function renderThemes(): void {
    grid.innerHTML = themesData.map((t) => {
      const isActive = t.name === activeTheme;
      let config: any;
      try {
        config = JSON.parse(t.configJson);
      } catch {
        config = { light: {}, dark: {} };
      }
      return `
        <div class="theme-card ${isActive ? 'active' : ''}" data-theme="${esc(t.name)}">
          <div class="theme-header">
            <h3 class="theme-name">${esc(t.name)}</h3>
            ${isActive ? '<span class="badge-current">当前</span>' : ''}
          </div>
          <div class="palette-preview">
            ${renderPalette('Light', config.light)}
            ${renderPalette('Dark', config.dark)}
          </div>
          <div class="theme-actions">
            <button class="btn-icon ghost" data-preview="${esc(t.name)}">${ICONS.eye}预览</button>
            <button class="btn-icon" data-edit="${esc(t.name)}">${ICONS.edit}编辑</button>
            ${isActive ? '' : `<button class="btn-icon accent" data-activate="${esc(t.name)}">${ICONS.check}设为当前</button>`}
          </div>
        </div>
      `;
    }).join('');

    // 预览按钮
    grid.querySelectorAll('[data-preview]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        openPreview(btn.getAttribute('data-preview')!);
      });
    });
    // 编辑按钮
    grid.querySelectorAll('[data-edit]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        openEdit(btn.getAttribute('data-edit')!);
      });
    });
    // 设为当前按钮
    grid.querySelectorAll('[data-activate]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        setActive(btn.getAttribute('data-activate')!);
      });
    });
    // 卡片点击切换激活主题
    grid.querySelectorAll('.theme-card').forEach((card) => {
      card.addEventListener('click', () => {
        const name = card.getAttribute('data-theme');
        if (name && name !== activeTheme) setActive(name);
      });
    });
  }

  /**
   * 渲染单套色板预览（显示全部 6 个字段色块 + 中文标签 + 色值）
   * @param title 区块标题（Light / Dark）
   * @param palette 色板对象
   * @returns HTML 字符串
   */
  function renderPalette(title: string, palette: any): string {
    return `
      <div class="palette-block">
        <span class="palette-title">${title}</span>
        <div class="palette-bg" style="background:${safeColor(palette?.background)}"></div>
        <div class="swatches">
          ${PREVIEW_KEYS.map((it) => `
            <div class="swatch-item">
              <div class="swatch" style="background:${safeColor(palette?.[it.key])}" title="${it.key}: ${esc(palette?.[it.key] ?? '')}"></div>
              <span class="swatch-label">${it.label}</span>
              <span class="swatch-value" title="${it.key}: ${esc(palette?.[it.key] ?? '')}">${esc(shortColor(palette?.[it.key]))}</span>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }

  /**
   * 切换激活主题
   * @param name 主题名
   */
  async function setActive(name: string): Promise<void> {
    const res = await fetch('/api/admin/theme', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ activeTheme: name }),
    });
    if (res.ok) {
      activeTheme = name;
      renderThemes();
    }
  }

  /* ---------- 主题实时预览 ---------- */
  const previewModal = document.getElementById('previewModal')!;
  const previewTitle = document.getElementById('previewTitle')!;
  const themePreview = document.getElementById('themePreview')!;
  /** 预览状态：当前预览的主题名与浅色/深色模式 */
  let previewThemeName = '';
  let previewMode: 'light' | 'dark' = 'light';

  /**
   * 打开主题预览弹窗并渲染模拟前台效果
   * @param name 主题名
   */
  function openPreview(name: string): void {
    const theme = themesData.find((t) => t.name === name);
    if (!theme) return;
    previewThemeName = name;
    previewTitle.textContent = `主题预览：${name}`;
    renderThemePreview();
    previewModal.classList.add('show');
  }

  /**
   * 按当前预览状态渲染模拟前台页面片段
   * 背景 / 文字 / 次要文字 / 强调色 / 卡片 / 边框全部取自主题色板，
   * 使预览效果与前台实际渲染保持一致
   */
  function renderThemePreview(): void {
    const theme = themesData.find((t) => t.name === previewThemeName);
    if (!theme) return;
    let config: any;
    try {
      config = JSON.parse(theme.configJson);
    } catch {
      config = { light: {}, dark: {} };
    }
    const p = config[previewMode] ?? {};
    const bg = safeColor(p.background);
    const fg = safeColor(p.foreground);
    const muted = safeColor(p.muted);
    const accent = safeColor(p.accent);
    const card = safeColor(p.card);
    const border = safeColor(p.border);

    themePreview.innerHTML = `
      <div style="background:${bg}; color:${fg}; border:1px solid ${border}; border-radius:12px; padding:18px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
          <span style="font-weight:700;">站点名称</span>
          <span style="font-size:0.72rem; color:${muted};">首页 · 服务 · 项目</span>
        </div>
        <div style="margin-bottom:18px;">
          <p style="font-size:1.15rem; font-weight:700; margin-bottom:4px;">页面标题示例</p>
          <p style="font-size:0.78rem; color:${muted}; margin-bottom:12px;">这是一段次要文字，用于观察 muted 颜色的可读性。</p>
          <span style="display:inline-block; padding:6px 14px; background:${accent}; color:#fff; border-radius:8px; font-size:0.72rem;">主要按钮</span>
          <span style="display:inline-block; padding:6px 14px; border:1px solid ${accent}; color:${accent}; border-radius:8px; font-size:0.72rem; margin-left:8px;">次要按钮</span>
        </div>
        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:10px;">
          ${[1, 2, 3].map(() => `
            <div style="background:${card}; border:1px solid ${border}; border-radius:10px; padding:12px;">
              <div style="height:40px; border-radius:6px; background:${accent}; opacity:0.25; margin-bottom:8px;"></div>
              <div style="height:8px; width:70%; border-radius:4px; background:${muted}; opacity:0.5; margin-bottom:6px;"></div>
              <div style="height:8px; width:45%; border-radius:4px; background:${muted}; opacity:0.35;"></div>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }

  // 浅色 / 深色模式切换
  previewModal.querySelectorAll('.mode-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      previewMode = (tab as HTMLElement).dataset.mode === 'dark' ? 'dark' : 'light';
      previewModal.querySelectorAll('.mode-tab').forEach((t) => t.classList.toggle('active', t === tab));
      renderThemePreview();
    });
  });
  // 关闭按钮 / 点击遮罩关闭
  document.getElementById('btnPreviewClose')!.addEventListener('click', () => previewModal.classList.remove('show'));
  previewModal.addEventListener('click', (e) => { if (e.target === previewModal) previewModal.classList.remove('show'); });

  /**
   * 构建颜色输入控件（color picker + 文本框）
   * @param container 容器元素
   * @param mode 模式（light / dark）
   */
  function buildColorInputs(container: HTMLElement, mode: 'light' | 'dark'): void {
    container.innerHTML = COLOR_KEYS.map((key) => `
      <div class="color-row">
        <label>${COLOR_LABELS[key]}</label>
        <div class="color-inputs">
          <input type="color" class="color-picker" data-mode="${mode}" data-key="${key}" />
          <input type="text" class="color-text" data-mode="${mode}" data-key="${key}" />
        </div>
      </div>
    `).join('');
  }

  /**
   * 绑定 color picker 与文本框的双向同步
   */
  function syncColorInputs(): void {
    document.querySelectorAll('.color-picker').forEach((el) => {
      const picker = el as HTMLInputElement;
      picker.addEventListener('input', () => {
        const mode = picker.dataset.mode!;
        const key = picker.dataset.key!;
        const text = document.querySelector(`.color-text[data-mode="${mode}"][data-key="${key}"]`) as HTMLInputElement | null;
        if (text) text.value = picker.value;
      });
    });
    document.querySelectorAll('.color-text').forEach((el) => {
      const text = el as HTMLInputElement;
      text.addEventListener('input', () => {
        const mode = text.dataset.mode!;
        const key = text.dataset.key!;
        const picker = document.querySelector(`.color-picker[data-mode="${mode}"][data-key="${key}"]`) as HTMLInputElement | null;
        if (!picker) return;
        const hex = toHex6(text.value);
        if (hex) {
          picker.value = hex;
          picker.disabled = false;
        } else {
          picker.disabled = true;
        }
      });
    });
  }

  /**
   * 打开编辑弹窗，填充当前主题色板数据
   * @param name 主题名
   */
  function openEdit(name: string): void {
    const theme = themesData.find((t) => t.name === name);
    if (!theme) return;
    let config: any;
    try {
      config = JSON.parse(theme.configJson);
    } catch {
      config = { light: {}, dark: {} };
    }

    (document.getElementById('editThemeName') as HTMLInputElement).value = name;
    modalTitle.textContent = `编辑主题：${name}`;

    COLOR_KEYS.forEach((key) => {
      const lightVal = config.light?.[key] ?? '';
      const darkVal = config.dark?.[key] ?? '';
      const lightText = document.querySelector(`.color-text[data-mode="light"][data-key="${key}"]`) as HTMLInputElement | null;
      const darkText = document.querySelector(`.color-text[data-mode="dark"][data-key="${key}"]`) as HTMLInputElement | null;
      const lightPicker = document.querySelector(`.color-picker[data-mode="light"][data-key="${key}"]`) as HTMLInputElement | null;
      const darkPicker = document.querySelector(`.color-picker[data-mode="dark"][data-key="${key}"]`) as HTMLInputElement | null;

      if (lightText) lightText.value = lightVal;
      if (darkText) darkText.value = darkVal;
      const lh = toHex6(lightVal);
      if (lightPicker) {
        lightPicker.value = lh ?? '#000000';
        lightPicker.disabled = !lh;
      }
      const dh = toHex6(darkVal);
      if (darkPicker) {
        darkPicker.value = dh ?? '#000000';
        darkPicker.disabled = !dh;
      }
    });

    modal.classList.add('show');
  }

  // 初始化：构建颜色输入控件并绑定同步
  buildColorInputs(document.getElementById('lightColors')!, 'light');
  buildColorInputs(document.getElementById('darkColors')!, 'dark');
  syncColorInputs();

  // 取消按钮 / 点击遮罩关闭弹窗
  document.getElementById('btnCancel')!.addEventListener('click', () => modal.classList.remove('show'));
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('show'); });

  // 表单提交：收集颜色数据并保存
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const themeName = (document.getElementById('editThemeName') as HTMLInputElement).value;
    const config: any = { light: {}, dark: {} };
    COLOR_KEYS.forEach((key) => {
      const lightText = document.querySelector(`.color-text[data-mode="light"][data-key="${key}"]`) as HTMLInputElement | null;
      const darkText = document.querySelector(`.color-text[data-mode="dark"][data-key="${key}"]`) as HTMLInputElement | null;
      config.light[key] = lightText?.value ?? '';
      config.dark[key] = darkText?.value ?? '';
    });
    await fetch('/api/admin/theme', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ themeName, config }),
    });
    modal.classList.remove('show');
    loadThemes();
  });

  // 首次加载
  loadThemes();
</script>
