---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="日常与交流" active="community"><div class="community-shell"><header class="hub-head"><div><small>LIFE / CONVERSATIONS</small><h1>记录片刻，回应来访。</h1><p>图文日常与每一段对话，都在这里。</p></div><a class="btn-secondary" href="/blog" target="_blank">查看博客 ↗</a></header><nav class="hub-tabs"><button data-tab="moments" class="active">日常动态</button><button data-tab="comments">评论管理</button><button data-tab="settings">展示设置</button></nav><p id="feedback" role="status"></p><div id="tab-moments" class="moment-layout"><section class="community-panel"><header><h2 id="composeTitle">今天，发生了什么？</h2><button type="button" id="cancelEdit" class="btn-icon">新建动态</button></header><form id="momentForm"><textarea id="momentContent" placeholder="写下生活的片刻…" maxlength="5000" required></textarea><div id="imageQueue"></div><label class="upload-action">＋ 添加照片（最多9张）<input type="file" id="momentFiles" multiple accept="image/jpeg,image/png,image/webp,image/gif"/></label><p id="uploadStatus" role="status"></p><button type="button" id="retryUpload" class="btn-secondary" hidden>重试未完成的照片</button><label>分享链接<input id="momentLink" placeholder="https://…"/></label><label>标签<input id="momentTags" placeholder="生活，随记，旅行" maxlength="200"/></label><div class="compose-options"><label><input id="momentPinned" type="checkbox"/> 置顶</label><label><input id="momentVisible" type="checkbox" checked/> 公开</label><button class="btn-primary" id="saveMoment">保存动态</button></div></form></section><section class="community-panel"><header><h2>动态记录</h2><select id="momentFilter" aria-label="动态状态"><option value="all">全部动态</option><option value="public">已公开</option><option value="draft">草稿</option><option value="trash">回收站</option></select></header><div id="moments"></div><div id="momentPaging" class="paging"></div></section></div><section id="tab-comments" class="community-panel" hidden><header><h2>每一条来访</h2><div><select id="commentFilter" aria-label="审核状态"><option value="all">全部状态</option><option value="pending">待审核</option><option value="public">已公开</option><option value="hidden">已隐藏</option></select><select id="targetFilter" aria-label="留言位置"><option value="all">全部位置</option><option value="article">文章评论</option><option value="moment">动态评论</option><option value="guestbook">访客留言</option></select></div></header><div id="bulkComments"><button type="button" id="approveSelected" class="btn-secondary">公开选中留言</button><button type="button" id="hideSelected" class="btn-secondary">隐藏选中留言</button></div><div id="comments"></div><div id="commentPaging" class="paging"></div></section><section id="tab-settings" class="community-panel" hidden><h2>让日常出现在合适的位置</h2><form id="displayForm"><label><input type="checkbox" id="showHome"/> 首页展示日常</label><label><input type="checkbox" id="showBlog"/> 博客展示日常</label><label>首页条数<input type="number" id="displayLimit" min="1" max="10"/></label><button class="btn-primary">保存设置</button></form></section></div></AdminLayout>
<script>
type Moment = {
  id: number;
  content: string;
  images_json: string;
  link: string;
  tags: string;
  pinned: number;
  visible: number;
  deleted_at: string | null;
  created_at: string;
};
let failedUploads: File[] = [];
let momentPage = 1,
  commentPage = 1;
let editing: number | undefined,
  images: string[] = [],
  moments: Moment[] = [],
  comments: any[] = [],
  uploading = false;
const $ = (id: string) => document.getElementById(id)!;
const input = (id: string) => $(id) as HTMLInputElement;
document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach(
  (button) =>
    (button.onclick = () => {
      document
        .querySelectorAll('[data-tab]')
        .forEach((b) => b.classList.toggle('active', b === button));
      for (const name of ['moments', 'comments', 'settings'])
        $(`tab-${name}`).hidden = name !== button.dataset.tab;
    }),
);
async function act(body: unknown) {
  const r = await fetch('/api/admin/community', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  const data = await r.json();
  if (!r.ok) throw Error(data.error || '保存失败');
  await load();
  $('feedback').textContent = '已保存';
}
function reset() {
  if (uploading) {
    $('feedback').textContent = '请等待当前照片上传完成';
    return;
  }
  failedUploads = [];
  $('retryUpload').hidden = true;
  $('uploadStatus').textContent = '';
  editing = undefined;
  images = [];
  ($('momentForm') as HTMLFormElement).reset();
  $('composeTitle').textContent = '今天，发生了什么？';
  renderImages();
}
const button = (label: string, action: () => void) => {
  const b = document.createElement('button');
  b.type = 'button';
  b.className = 'btn-icon';
  b.textContent = label;
  b.onclick = action;
  return b;
};
function renderImages() {
  $('imageQueue').replaceChildren();
  images.forEach((url, index) => {
    const cell = document.createElement('div');
    cell.draggable = true;
    cell.ondragstart = (e) =>
      e.dataTransfer?.setData('text/plain', String(index));
    cell.ondragover = (e) => e.preventDefault();
    cell.ondrop = (e) => {
      e.preventDefault();
      const from = Number(e.dataTransfer?.getData('text/plain'));
      if (Number.isInteger(from) && from >= 0 && from < images.length) {
        const [item] = images.splice(from, 1);
        images.splice(index, 0, item);
        renderImages();
      }
    };
    const image = document.createElement('img');
    image.src = url;
    image.alt = `照片 ${index + 1}`;
    cell.append(
      image,
      button('移除', () => {
        images.splice(index, 1);
        renderImages();
      }),
      button('←', () => {
        if (index) {
          [images[index - 1], images[index]] = [
            images[index],
            images[index - 1],
          ];
          renderImages();
        }
      }),
    );
    cell.append(
      button('替换', () => {
        const old = images[index];
        const file = document.createElement('input');
        file.type = 'file';
        file.accept = 'image/jpeg,image/png,image/webp,image/gif';
        file.onchange = async () => {
          if (!file.files?.[0]) return;
          const data = new FormData();
          data.append('file', file.files[0]);
          try {
            $('uploadStatus').textContent = '正在替换照片…';
            const response = await fetch('/api/admin/media', {
              method: 'POST',
              body: data,
            });
            const result = await response.json();
            if (!response.ok) throw Error(result.error);
            const current = images.indexOf(old);
            if (current >= 0) images[current] = result.url;
            renderImages();
            $('uploadStatus').textContent = '照片已替换';
          } catch (error) {
            $('uploadStatus').textContent = (error as Error).message;
          }
        };
        file.click();
      }),
    );
    $('imageQueue').append(cell);
  });
}
async function uploadFiles(files: File[]) {
  if (files.length + images.length > 9) {
    $('uploadStatus').textContent = '每条动态最多9张图片';
    return;
  }
  failedUploads = [];
  $('retryUpload').hidden = true;
  uploading = true;
  input('saveMoment').disabled = true;
  for (const [index, file] of files.entries()) {
    try {
      $('uploadStatus').textContent =
        `正在上传 ${index + 1}/${files.length} · ${file.name}`;
      const form = new FormData();
      form.append('file', file);
      const r = await fetch('/api/admin/media', { method: 'POST', body: form });
      const data = await r.json();
      if (!r.ok) throw Error(data.error);
      images.push(data.url);
      renderImages();
    } catch (e) {
      $('uploadStatus').textContent =
        `${file.name} 上传失败：${(e as Error).message}，请重新选择该文件重试`;
      failedUploads = files.slice(index);
      $('retryUpload').hidden = false;
      uploading = false;
      input('saveMoment').disabled = false;
      return;
    }
  }
  uploading = false;
  input('saveMoment').disabled = false;
  input('momentFiles').value = '';
  $('uploadStatus').textContent = '照片已上传，可拖动排序';
}
input('momentFiles').onchange = () =>
  uploadFiles(Array.from(input('momentFiles').files || []));
$('retryUpload').onclick = () => uploadFiles(failedUploads);

function renderMoments() {
  $('moments').replaceChildren();
  const filter = input('momentFilter').value;
  for (const row of moments.filter((row) =>
    filter === 'trash'
      ? row.deleted_at
      : !row.deleted_at &&
        (filter === 'all' ||
          (filter === 'public' ? row.visible : !row.visible)),
  )) {
    const article = document.createElement('article');
    const meta = document.createElement('small');
    meta.textContent = `${row.pinned ? '置顶 · ' : ''}${row.visible ? '已公开' : '草稿'} · ${row.created_at}`;
    const p = document.createElement('p');
    p.textContent = row.content;
    article.append(meta, p);
    const count = JSON.parse(row.images_json || '[]').length;
    if (count) {
      const hint = document.createElement('small');
      hint.textContent = `${count} 张照片`;
      article.append(hint);
    }
    article.append(
      button(row.deleted_at ? '恢复为草稿' : '编辑', () => {
        if (row.deleted_at) {
          act({ action: 'restore-moment', id: row.id }).catch(report);
          return;
        }
        editing = row.id;
        input('momentContent').value = row.content;
        input('momentLink').value = row.link;
        input('momentTags').value = row.tags;
        input('momentVisible').checked = !!row.visible;
        input('momentPinned').checked = !!row.pinned;
        images = JSON.parse(row.images_json || '[]');
        renderImages();
        $('composeTitle').textContent = '编辑这段日常';
        input('momentContent').focus();
      }),
    );
    if (!row.deleted_at)
      article.append(
        button('移入回收站', () =>
          act({ action: 'trash-moment', id: row.id }).catch(report),
        ),
      );
    $('moments').append(article);
  }
  if (!$('moments').children.length)
    $('moments').textContent = '这里还没有动态。';
}
function renderComments() {
  $('comments').replaceChildren();
  for (const row of comments) {
    const type = row.moment_id
      ? 'moment'
      : row.article_id
        ? 'article'
        : 'guestbook';
    const filter = input('commentFilter').value;
    if (
      (filter === 'pending' && row.approved) ||
      (filter === 'public' && !row.approved) ||
      (input('targetFilter').value !== 'all' &&
        input('targetFilter').value !== type)
    )
      continue;
    const article = document.createElement('article');
    const select = document.createElement('input');
    select.type = 'checkbox';
    select.dataset.id = String(row.id);
    select.setAttribute('aria-label', '选择 ' + row.name + ' 的留言');
    article.append(select);
    const title = document.createElement('strong');
    title.textContent = `${row.name} · ${type === 'article' ? '文章 #' + row.article_id : type === 'moment' ? '动态 #' + row.moment_id : '访客留言'} · ${row.approved ? '已公开' : '待审核'}`;
    const content = document.createElement('p');
    content.textContent = row.content;
    article.append(title, content);
    for (const [label, action] of [
      ['公开', 'approve'],
      ['隐藏', 'hide'],
      ['删除', 'delete-comment'],
    ])
      article.append(
        button(label, () => {
          if (
            action === 'delete-comment' &&
            !confirm('删除后保留楼层占位，确定？')
          )
            return;
          act({ action, id: row.id }).catch(report);
        }),
      );
    const reply = button('回复', () => {
      if (article.querySelector('form')) return;
      const form = document.createElement('form');
      const textarea = document.createElement('textarea');
      textarea.required = true;
      textarea.placeholder = '以博主身份回复…';
      const send = document.createElement('button');
      send.className = 'btn-primary';
      send.textContent = '发布回复';
      form.append(
        textarea,
        send,
        button('取消', () => form.remove()),
      );
      form.onsubmit = async (e) => {
        e.preventDefault();
        try {
          await act({ action: 'reply', id: row.id, content: textarea.value });
        } catch (e) {
          report(e);
        }
      };
      article.append(form);
      textarea.focus();
    });
    reply.disabled = !row.approved;
    article.append(reply);
    $('comments').append(article);
  }
  if (!$('comments').children.length)
    $('comments').textContent = '没有符合筛选条件的留言。';
}
function report(e: unknown) {
  $('feedback').textContent = (e as Error).message;
}
async function load() {
  const query = new URLSearchParams({
    momentPage: String(momentPage),
    commentPage: String(commentPage),
    momentFilter: input('momentFilter').value,
    commentFilter: input('commentFilter').value,
    target: input('targetFilter').value,
  });
  const r = await fetch('/api/admin/community?' + query);
  if (!r.ok) throw Error('读取失败，请重新登录');
  const data = await r.json();
  moments = data.moments;
  comments = data.comments;
  input('showHome').checked = data.settings.home;
  input('showBlog').checked = data.settings.blog;
  input('displayLimit').value = data.settings.limit;
  renderMoments();
  renderComments();
  for (const [key, total, page] of [
    ['momentPaging', data.momentTotal, momentPage],
    ['commentPaging', data.commentTotal, commentPage],
  ] as const) {
    $(key).replaceChildren();
    const count = document.createElement('span');
    count.textContent = `${page} / ${Math.max(1, Math.ceil(total / 20))} · 共 ${total} 条`;
    const prev = button('←', () => {
      if (key === 'momentPaging') momentPage--;
      else commentPage--;
      load().catch(report);
    });
    prev.disabled = page <= 1;
    const next = button('→', () => {
      if (key === 'momentPaging') momentPage++;
      else commentPage++;
      load().catch(report);
    });
    next.disabled = page * 20 >= total;
    $(key).append(prev, count, next);
  }
}
$('momentForm').onsubmit = async (e) => {
  e.preventDefault();
  if (uploading) return;
  try {
    await act({
      action: 'moment',
      id: editing,
      content: input('momentContent').value,
      visible: input('momentVisible').checked,
      pinned: input('momentPinned').checked,
      images,
      link: input('momentLink').value,
      tags: input('momentTags').value,
    });
    reset();
  } catch (e) {
    report(e);
  }
};
$('cancelEdit').onclick = reset;
$('momentFilter').onchange = () => {
  momentPage = 1;
  load().catch(report);
};
$('commentFilter').onchange = $('targetFilter').onchange = () => {
  commentPage = 1;
  load().catch(report);
};
$('displayForm').onsubmit = async (e) => {
  e.preventDefault();
  try {
    await act({
      action: 'settings',
      settings: {
        home: input('showHome').checked,
        blog: input('showBlog').checked,
        limit: Number(input('displayLimit').value),
      },
    });
  } catch (e) {
    report(e);
  }
};
for (const [id, operation] of [
  ['approveSelected', 'approve'],
  ['hideSelected', 'hide'],
])
  $(id).onclick = () => {
    const ids = Array.from(
      document.querySelectorAll<HTMLInputElement>('#comments input:checked'),
    ).map((input) => Number(input.dataset.id));
    if (!ids.length) {
      $('feedback').textContent = '请先选择留言';
      return;
    }
    void act({ action: 'batch', operation, ids }).catch(report);
  };
load().catch(report);
</script>
<style>.community-shell{max-width:1300px;margin:auto}.hub-head{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:26px}.hub-head small{font-size:10px;color:#8b998d;letter-spacing:.15em}h1{font-size:27px;margin:10px 0}.hub-head p{font-size:13px;color:#89968c}.hub-tabs{display:flex;gap:24px;border-bottom:1px solid #e0e7dd;margin-bottom:20px}.hub-tabs button{padding:12px 0;color:#7e8b80;font-size:13px;border-bottom:2px solid transparent}.hub-tabs .active{color:#435f46;border-bottom-color:#435f46}.moment-layout{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start}.community-panel{padding:24px;background:white;border:1px solid #e0e7df;border-radius:14px}.community-panel header{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:18px}h2{font-size:16px}textarea{width:100%;min-height:150px;padding:14px;border:1px solid #e2e7df;border-radius:8px;font:inherit;margin:12px 0;resize:vertical}label{display:block;color:#7e8b7a;font-size:12px;margin:14px 0}label>input:not([type=checkbox]){display:block;width:100%;padding:10px;margin-top:7px;border:1px solid #e0e7df;border-radius:7px}.compose-options{display:flex;align-items:center;gap:18px}.compose-options button{margin-left:auto}.upload-action{display:inline-block;padding:9px 12px;background:#f2f6ef;border-radius:7px;cursor:pointer}.upload-action input{display:none}#imageQueue{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}#imageQueue :global(img){width:100%;aspect-ratio:1;object-fit:cover;border-radius:8px}#imageQueue :global(button){font-size:10px;padding:3px}article,:global(#moments article),:global(#comments article){padding:18px 0;border-bottom:1px solid #e8ece5}:global(article p){white-space:pre-wrap;line-height:1.8;font-size:14px;margin:12px 0}:global(article small){font-size:11px;color:#8a9686}:global(article .btn-icon){margin:8px 7px 0 0}select{padding:8px;border:1px solid #e0e7df;border-radius:6px;font-size:12px;background:white}#feedback,#uploadStatus{font-size:12px;color:#647b59;margin:12px 0}[hidden]{display:none!important}@media(max-width:900px){.moment-layout{grid-template-columns:1fr}.hub-head{align-items:flex-start;flex-direction:column}.community-panel header{flex-wrap:wrap}}
</style>
