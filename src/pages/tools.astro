---
import Layout from '../layouts/Layout.astro';
import '../styles/tools.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteConfig } from '../lib/queries';

const site = getSiteConfig();
---

<Layout title={`在线开发工具 | ${site.name}`} description="免费的 JSON、时间戳、编码、JWT、进制转换、抽奖、正则、颜色、随机数和密码生成工具。">
  <Header />
  <main class="container tools-shell">
    <header class="tools-intro">
      <div><p class="eyebrow">THE TOOLKIT / 日常效率</p><h1>小工具，大方便<span>。</span></h1><p class="tools-description">处理一段数据，省下一点时间。</p></div>
      <div class="tools-intro-side"><p><span aria-hidden="true">●</span> 浏览器本地处理</p></div></header>
    <div class="tool-workbench"><aside class="tool-directory" aria-label="工具目录"><div class="directory-head"><strong>工具目录 <small>14</small></strong><label class="tool-search"><span aria-hidden="true">⌕</span><input id="toolSearch" type="search" placeholder="搜索工具…" aria-label="搜索工具" /></label></div><label class="mobile-tool-picker">选择工具<select id="toolPicker" aria-label="当前工具"></select></label>
      <div class="tool-tabs" role="tablist" aria-label="选择工具" aria-orientation="vertical">
        <button id="tool-tab-json" role="tab" aria-selected="true" aria-controls="panel-json" data-tool="json"><span>{'{ }'}</span><strong>JSON</strong><small>格式化</small></button>
        <button id="tool-tab-timestamp" role="tab" aria-selected="false" aria-controls="panel-timestamp" data-tool="timestamp" tabindex="-1"><span>T</span><strong>时间戳</strong><small>日期互转</small></button>
        <button id="tool-tab-base64" role="tab" aria-selected="false" aria-controls="panel-base64" data-tool="base64" tabindex="-1"><span>64</span><strong>Base64</strong><small>编码解码</small></button>
        <button id="tool-tab-url" role="tab" aria-selected="false" aria-controls="panel-url" data-tool="url" tabindex="-1"><span>%</span><strong>URL</strong><small>编码解码</small></button>
        <button id="tool-tab-uuid" role="tab" aria-selected="false" aria-controls="panel-uuid" data-tool="uuid" tabindex="-1"><span>ID</span><strong>UUID</strong><small>随机生成</small></button>
        <button id="tool-tab-hash" role="tab" aria-selected="false" aria-controls="panel-hash" data-tool="hash" tabindex="-1"><span>#</span><strong>SHA-256</strong><small>摘要计算</small></button>
        <button id="tool-tab-jwt" role="tab" aria-selected="false" aria-controls="panel-jwt" data-tool="jwt" tabindex="-1"><span>JW</span><strong>JWT</strong><small>Token 解析</small></button>
        <button id="tool-tab-radix" role="tab" aria-selected="false" aria-controls="panel-radix" data-tool="radix" tabindex="-1"><span>0x</span><strong>进制转换</strong><small>2 / 8 / 10 / 16</small></button>
        <button id="tool-tab-text" role="tab" aria-selected="false" aria-controls="panel-text" data-tool="text" tabindex="-1"><span>Ab</span><strong>文本统计</strong><small>字数与字节</small></button>
        <button id="tool-tab-password" role="tab" aria-selected="false" aria-controls="panel-password" data-tool="password" tabindex="-1"><span>R</span><strong>随机生成</strong><small>密码 / 数字</small></button>
        <button id="tool-tab-lottery" role="tab" aria-selected="false" aria-controls="panel-lottery" data-tool="lottery" tabindex="-1"><span>奖</span><strong>抽奖</strong><small>人员 / 奖品</small></button>
        <button id="tool-tab-regex" role="tab" aria-selected="false" aria-controls="panel-regex" data-tool="regex" tabindex="-1"><span>.*</span><strong>正则测试</strong><small>匹配预览</small></button>
        <button id="tool-tab-color" role="tab" aria-selected="false" aria-controls="panel-color" data-tool="color" tabindex="-1"><span>◐</span><strong>颜色转换</strong><small>HEX / RGB</small></button>
        <button id="tool-tab-qrcode" role="tab" aria-selected="false" aria-controls="panel-qrcode" data-tool="qrcode" tabindex="-1"><span>▦</span><strong>二维码</strong><small>生成下载</small></button>
      </div><p class="tool-no-results" id="toolNoResults" hidden>没有匹配的工具</p><p class="directory-note">无需安装 · 内容不上传</p></aside>

      <div class="tool-stage">
      <section class="tool-panel" id="panel-json" role="tabpanel" aria-labelledby="tool-tab-json" data-tool-panel="json">
        <div class="tool-copy"><span class="tool-number">01</span><div><h2 id="json-title">JSON 格式化</h2><p>校验 JSON，并按需要美化或压缩。</p></div></div>
        <div class="tool-workspace">
          <label for="jsonInput">输入</label>
          <textarea id="jsonInput" spellcheck="false" placeholder='{"hello":"world"}'></textarea>
          <div class="actions"><button data-json="format">格式化</button><button data-json="minify">压缩</button><button class="secondary" data-copy="jsonInput">复制</button><button class="ghost" data-clear="jsonInput">清空</button></div>
          <p class="status" id="jsonStatus" aria-live="polite"></p>
        </div>
      </section>

      <section class="tool-panel" id="panel-timestamp" role="tabpanel" aria-labelledby="tool-tab-timestamp" data-tool-panel="timestamp" hidden>
        <div class="tool-copy"><span class="tool-number">02</span><div><h2 id="timestamp-title">时间戳转换</h2><p>自动识别秒或毫秒，也可从本地日期生成时间戳。</p></div></div>
        <div class="tool-workspace two-fields">
          <label for="timestampInput">时间戳</label><input id="timestampInput" inputmode="numeric" autocomplete="off" />
          <div class="result-box" id="timestampResult" aria-live="polite"></div>
          <label for="dateInput">本地日期时间</label><input id="dateInput" type="datetime-local" step="1" />
          <div class="result-box" id="dateResult" aria-live="polite"></div>
          <div class="actions"><button id="timestampNow">使用当前时间</button></div>
        </div>
      </section>

      <section class="tool-panel" id="panel-base64" role="tabpanel" aria-labelledby="tool-tab-base64" data-tool-panel="base64" hidden>
        <div class="tool-copy"><span class="tool-number">03</span><div><h2 id="base64-title">Base64 编解码</h2><p>对 UTF-8 文本进行 Base64 编码或解码。</p></div></div>
        <div class="tool-workspace">
          <label for="base64Input">文本或 Base64</label><textarea id="base64Input" spellcheck="false" placeholder="输入要处理的内容"></textarea>
          <div class="actions"><button data-base64="encode">编码</button><button data-base64="decode">解码</button><button class="secondary" data-copy="base64Input">复制</button><button class="ghost" data-clear="base64Input">清空</button></div>
          <p class="status" id="base64Status" aria-live="polite"></p>
        </div>
      </section>

      <section class="tool-panel" id="panel-url" role="tabpanel" aria-labelledby="tool-tab-url" data-tool-panel="url" hidden>
        <div class="tool-copy"><span class="tool-number">04</span><div><h2 id="url-title">URL 编解码</h2><p>使用 percent-encoding 处理路径、查询参数或文本。</p></div></div>
        <div class="tool-workspace">
          <label for="urlInput">输入</label><textarea id="urlInput" spellcheck="false" placeholder="https://example.com/search?q=你好"></textarea>
          <div class="actions"><button data-url="encode">编码</button><button data-url="decode">解码</button><button class="secondary" data-copy="urlInput">复制</button><button class="ghost" data-clear="urlInput">清空</button></div>
          <p class="status" id="urlStatus" aria-live="polite"></p>
        </div>
      </section>

      <section class="tool-panel compact" id="panel-uuid" role="tabpanel" aria-labelledby="tool-tab-uuid" data-tool-panel="uuid" hidden>
        <div class="tool-copy"><span class="tool-number">05</span><div><h2 id="uuid-title">UUID 生成</h2><p>生成符合 RFC 4122 的随机 UUID v4。</p></div></div>
        <div class="tool-workspace"><label for="uuidOutput">生成结果</label><input id="uuidOutput" readonly /><div class="actions"><button id="uuidGenerate">生成 UUID</button><button class="secondary" data-copy="uuidOutput">复制</button></div><p class="status" id="uuidStatus" aria-live="polite"></p></div>
      </section>

      <section class="tool-panel compact" id="panel-hash" role="tabpanel" aria-labelledby="tool-tab-hash" data-tool-panel="hash" hidden>
        <div class="tool-copy"><span class="tool-number">06</span><div><h2 id="hash-title">SHA-256 计算</h2><p>使用浏览器 Web Crypto 生成文本摘要。</p></div></div>
        <div class="tool-workspace"><label for="hashInput">输入文本</label><textarea id="hashInput" spellcheck="false"></textarea><label for="hashOutput">摘要</label><textarea id="hashOutput" readonly spellcheck="false"></textarea><div class="actions"><button id="hashGenerate">计算 SHA-256</button><button class="secondary" data-copy="hashOutput">复制</button></div><p class="status" id="hashStatus" aria-live="polite"></p></div>
      </section>

      <section class="tool-panel compact" id="panel-jwt" role="tabpanel" aria-labelledby="tool-tab-jwt" data-tool-panel="jwt" hidden>
        <div class="tool-copy"><span class="tool-number">07</span><div><h2>JWT 解析</h2><p>解析 Header 和 Payload，不会验证签名。</p></div></div>
        <div class="tool-workspace"><label for="jwtInput">JWT Token</label><textarea id="jwtInput" spellcheck="false" placeholder="eyJhbGciOi..."></textarea><label for="jwtOutput">解析结果</label><textarea id="jwtOutput" readonly spellcheck="false"></textarea><div class="actions"><button id="jwtDecode">解析 JWT</button><button class="secondary" data-copy="jwtOutput">复制结果</button><button class="ghost" data-clear="jwtInput">清空</button></div><p class="status" id="jwtStatus" aria-live="polite"></p></div>
      </section>

      <section class="tool-panel compact" id="panel-radix" role="tabpanel" aria-labelledby="tool-tab-radix" data-tool-panel="radix" hidden>
        <div class="tool-copy"><span class="tool-number">08</span><div><h2>进制转换</h2><p>在任意一栏输入整数，其他进制会同时换算。</p></div></div>
        <div class="tool-workspace"><p class="radix-hint">支持负整数；点击任意输入框即可改用该进制换算。</p><div class="radix-fields" aria-describedby="radixStatus"><div class="radix-row"><label for="radix10"><span>十进制</span><small>0–9</small></label><div><input id="radix10" data-radix="10" autocomplete="off" spellcheck="false" inputmode="numeric" placeholder="——" /><button type="button" data-copy="radix10" aria-label="复制十进制结果">复制</button></div></div><div class="radix-row"><label for="radix2"><span>二进制</span><small>0–1</small></label><div><input id="radix2" data-radix="2" autocomplete="off" spellcheck="false" inputmode="numeric" placeholder="——" /><button type="button" data-copy="radix2" aria-label="复制二进制结果">复制</button></div></div><div class="radix-row"><label for="radix8"><span>八进制</span><small>0–7</small></label><div><input id="radix8" data-radix="8" autocomplete="off" spellcheck="false" inputmode="numeric" placeholder="——" /><button type="button" data-copy="radix8" aria-label="复制八进制结果">复制</button></div></div><div class="radix-row"><label for="radix16"><span>十六进制</span><small>0–9, A–F</small></label><div><input id="radix16" data-radix="16" autocomplete="off" spellcheck="false" autocapitalize="characters" placeholder="——" /><button type="button" data-copy="radix16" aria-label="复制十六进制结果">复制</button></div></div></div><div class="actions radix-actions"><button class="ghost" type="button" id="radixClear">全部清空</button></div><p class="status" id="radixStatus" aria-live="polite"></p></div>
      </section>

      <section class="tool-panel compact" id="panel-text" role="tabpanel" aria-labelledby="tool-tab-text" data-tool-panel="text" hidden>
        <div class="tool-copy"><span class="tool-number">09</span><div><h2>文本统计</h2><p>实时统计字符、单词、行数和 UTF-8 字节数。</p></div></div>
        <div class="tool-workspace"><label for="textInput">输入文本</label><textarea id="textInput" placeholder="在此输入或粘贴文本"></textarea><div class="metrics" aria-live="polite"><div><strong id="textChars">0</strong><span>字符</span></div><div><strong id="textNoSpaces">0</strong><span>不含空白</span></div><div><strong id="textWords">0</strong><span>词数</span></div><div><strong id="textLines">0</strong><span>行数</span></div><div><strong id="textBytes">0</strong><span>UTF-8 字节</span></div></div><div class="actions"><button class="secondary" data-copy="textInput">复制文本</button><button class="ghost" data-clear="textInput">清空</button></div><p class="status" id="textStatus" aria-live="polite"></p></div>
      </section>

      <section class="tool-panel compact" id="panel-password" role="tabpanel" aria-labelledby="tool-tab-password" data-tool-panel="password" hidden>
        <div class="tool-copy"><span class="tool-number">10</span><div><h2>随机生成</h2><p>生成安全密码或指定范围内的随机整数。</p></div></div>
        <div class="subtabs" role="tablist" aria-label="随机生成类型"><button class="active" data-random-mode="password">安全密码</button><button data-random-mode="number">随机数</button></div>
        <div class="tool-workspace" data-random-panel="password"><label for="passwordOutput">生成结果</label><input id="passwordOutput" readonly /><div class="range-row"><label for="passwordLength">长度 <strong id="passwordLengthValue">20</strong></label><input id="passwordLength" type="range" min="8" max="64" value="20" /></div><fieldset class="option-grid"><legend>包含字符</legend><label><input type="checkbox" id="passwordLower" checked /> 小写字母</label><label><input type="checkbox" id="passwordUpper" checked /> 大写字母</label><label><input type="checkbox" id="passwordDigits" checked /> 数字</label><label><input type="checkbox" id="passwordSymbols" checked /> 符号</label></fieldset><div class="actions"><button id="passwordGenerate">生成密码</button><button class="secondary" data-copy="passwordOutput">复制密码</button></div><p class="status" id="passwordStatus" aria-live="polite"></p></div>
        <div class="tool-workspace" data-random-panel="number" hidden><div class="random-fields"><div><label for="randomMin">最小值</label><input id="randomMin" type="number" value="1" /></div><div><label for="randomMax">最大值</label><input id="randomMax" type="number" value="100" /></div><div><label for="randomCount">数量</label><input id="randomCount" type="number" min="1" max="100" value="1" /></div></div><label class="random-option"><input id="randomUnique" type="checkbox" checked /> 结果不重复</label><textarea id="randomOutput" readonly spellcheck="false" placeholder="——"></textarea><div class="actions"><button id="randomGenerate">生成随机数</button><button class="secondary" data-copy="randomOutput">复制结果</button></div><p class="status" id="randomStatus" aria-live="polite"></p></div>
      </section>

      <section class="tool-panel compact" id="panel-lottery" role="tabpanel" aria-labelledby="tool-tab-lottery" data-tool-panel="lottery" hidden>
        <div class="tool-copy"><span class="tool-number">11</span><div><h2>抽奖</h2><p>使用系统安全随机数抽取，名单与奖品不会上传。</p></div></div>
        <div class="subtabs" role="tablist" aria-label="抽奖方式"><button class="active" data-lottery-mode="people">方式 A · 奖品与候选人</button><button data-lottery-mode="prize">方式 B · 只抽奖品</button></div>
        <div class="tool-workspace lottery-panel" data-lottery-panel="people"><div class="lottery-grid"><div><label for="lotteryPrizesA">奖品与中奖概率</label><textarea id="lotteryPrizesA" spellcheck="false" placeholder="一等奖 | 100%&#10;二等奖 | 50%"></textarea><small>每行：奖品 | 概率。每项独立判断是否中奖。</small></div><div><label for="lotteryPeople">候选人</label><textarea id="lotteryPeople" spellcheck="false" placeholder="张三&#10;李四&#10;王五"></textarea><small>每行一人；同一次抽奖不会重复中奖。</small></div></div><div class="actions"><button id="lotteryDrawA">开始抽奖</button></div></div>
        <div class="tool-workspace lottery-panel" data-lottery-panel="prize" hidden><label for="lotteryPrizesB">奖品与概率</label><textarea id="lotteryPrizesB" spellcheck="false" placeholder="一等奖 | 10%&#10;二等奖 | 30%&#10;参与奖 | 60%"></textarea><small>每行：奖品 | 概率；总概率不可超过 100%，不足部分视为未中奖。</small><div class="actions"><button id="lotteryDrawB">抽取奖品</button></div></div>
        <div class="lottery-result" id="lotteryResult" aria-live="polite">等待抽取</div><p class="status" id="lotteryStatus" aria-live="polite"></p>
      </section>

      <section class="tool-panel compact" id="panel-regex" role="tabpanel" aria-labelledby="tool-tab-regex" data-tool-panel="regex" hidden>
        <div class="tool-copy"><span class="tool-number">12</span><div><h2>正则测试</h2><p>输入表达式和文本，实时查看匹配结果。</p></div></div>
        <div class="tool-workspace"><div class="regex-pattern"><span>/</span><input id="regexPattern" spellcheck="false" placeholder="例如：\\d+" aria-label="正则表达式" /><span>/</span><input id="regexFlags" spellcheck="false" value="g" maxlength="6" aria-label="正则标志" /></div><label for="regexText">测试文本</label><textarea id="regexText" spellcheck="false" placeholder="输入待匹配文本"></textarea><div class="result-box compact-result" id="regexResult">——</div><p class="status" id="regexStatus" aria-live="polite"></p></div>
      </section>

      <section class="tool-panel compact" id="panel-color" role="tabpanel" aria-labelledby="tool-tab-color" data-tool-panel="color" hidden>
        <div class="tool-copy"><span class="tool-number">13</span><div><h2>颜色转换</h2><p>HEX 与 RGB 双向转换，并实时预览颜色。</p></div></div>
        <div class="tool-workspace color-workspace"><input id="colorPicker" type="color" value="#3b82f6" aria-label="选择颜色" /><div><label for="colorHex">HEX</label><input id="colorHex" value="#3B82F6" spellcheck="false" /><label for="colorRgb">RGB</label><input id="colorRgb" value="rgb(59, 130, 246)" spellcheck="false" /></div><div class="color-preview" id="colorPreview" aria-label="颜色预览"></div></div><p class="status" id="colorStatus" aria-live="polite"></p>
      </section>

      <section class="tool-panel compact" id="panel-qrcode" role="tabpanel" aria-labelledby="tool-tab-qrcode" data-tool-panel="qrcode" hidden>
        <div class="tool-copy"><span class="tool-number">14</span><div><h2>二维码生成</h2><p>将网址或文本生成二维码，可直接下载 PNG。</p></div></div>
        <div class="tool-workspace qr-workspace"><div><label for="qrInput">网址或文本</label><textarea id="qrInput" spellcheck="false" maxlength="2000" placeholder="https://luen0511.com"></textarea><p class="qr-note">固定生成 256 × 256 PNG，使用最高纠错级别。</p><div class="actions"><button id="qrGenerate">生成二维码</button><button class="secondary" id="qrDownload" disabled>下载 PNG</button><button class="ghost" id="qrClear">清空</button></div><p class="status" id="qrStatus" aria-live="polite"></p></div><div class="qr-preview" id="qrPreview"><canvas id="qrCanvas" hidden></canvas><span>二维码将在这里显示</span></div></div>
      </section>

      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import QRCode from 'qrcode';
  const byId=<T extends HTMLElement>(id:string)=>document.getElementById(id) as T;
  const status=(id:string,message:string,error=false)=>{const el=byId<HTMLElement>(id);el.textContent=message;el.classList.toggle('error',error);};
  const fieldStatus:Record<string,string|undefined>={jsonInput:'jsonStatus',base64Input:'base64Status',urlInput:'urlStatus',uuidOutput:'uuidStatus',hashOutput:'hashStatus',jwtInput:'jwtStatus',jwtOutput:'jwtStatus',radix10:'radixStatus',radix2:'radixStatus',radix8:'radixStatus',radix16:'radixStatus',textInput:'textStatus',passwordOutput:'passwordStatus',randomOutput:'randomStatus'};
  const toolTabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tool]'));
  const toolPanels=Array.from(document.querySelectorAll<HTMLElement>('[data-tool-panel]'));
  const toolIds=toolTabs.map(tab=>tab.dataset.tool!);
  const picker=byId<HTMLSelectElement>('toolPicker');
  toolTabs.forEach(tab=>{const option=document.createElement('option');option.textContent=tab.querySelector('strong')!.textContent!;option.value=tab.dataset.tool!;picker.append(option);});
  picker.addEventListener('change',()=>activateTool(picker.value));
  const activateTool=(id:string,updateUrl=true)=>{
    if(!toolIds.includes(id))id='json';
    picker.value=id;
    toolTabs.forEach(tab=>{const active=tab.dataset.tool===id;tab.setAttribute('aria-selected',String(active));tab.tabIndex=active?0:-1;});
    toolPanels.forEach(panel=>{panel.hidden=panel.dataset.toolPanel!==id;});
    if(updateUrl)history.replaceState(null,'',`#${id}`);
  };
  toolTabs.forEach((tab)=>{tab.addEventListener('click',()=>activateTool(tab.dataset.tool!));tab.addEventListener('keydown',event=>{const previous=event.key==='ArrowLeft'||event.key==='ArrowUp';const next=event.key==='ArrowRight'||event.key==='ArrowDown';if(!previous&&!next)return;event.preventDefault();const visible=toolTabs.filter(item=>!item.hidden);const target=(visible.indexOf(tab)+(previous?-1:1)+visible.length)%visible.length;visible[target]?.focus();if(visible[target])activateTool(visible[target].dataset.tool!);});});
  window.addEventListener('hashchange',()=>activateTool(location.hash.slice(1),false));
  activateTool(location.hash.slice(1),false);

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{
    const field=byId<HTMLInputElement|HTMLTextAreaElement>(button.dataset.copy!);
    const statusId=fieldStatus[field.id];
    if(!field.value){if(statusId)status(statusId,'没有可复制的内容',true);return;}
    try{await navigator.clipboard.writeText(field.value);button.textContent='已复制';if(statusId)status(statusId,'已复制到剪贴板');}catch{button.textContent='复制失败';if(statusId)status(statusId,'浏览器拒绝了剪贴板访问',true);}finally{setTimeout(()=>{button.textContent='复制';},1200);}
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-clear]').forEach(button=>button.addEventListener('click',()=>{const field=byId<HTMLInputElement|HTMLTextAreaElement>(button.dataset.clear!);field.value='';field.dispatchEvent(new Event('input',{bubbles:true}));const statusId=fieldStatus[field.id];if(statusId)status(statusId,'');field.focus();}));
  ['jsonInput','base64Input','urlInput'].forEach(id=>byId(id).addEventListener('input',()=>status(fieldStatus[id]!,'') ));

  document.querySelectorAll<HTMLButtonElement>('[data-json]').forEach(button=>button.addEventListener('click',()=>{
    const input=byId<HTMLTextAreaElement>('jsonInput');
    if(!input.value.trim()){status('jsonStatus','请先输入 JSON 内容',true);input.focus();return;}
    try{const parsed=JSON.parse(input.value);if(parsed===null||typeof parsed!=='object')throw new Error('请输入 JSON 对象或数组');input.value=JSON.stringify(parsed,null,button.dataset.json==='format'?2:0);status('jsonStatus',button.dataset.json==='format'?'格式化完成':'压缩完成');}catch(error){status('jsonStatus',`JSON 错误：${(error as Error).message}`,true);}
  }));

  const localInputValue=(date:Date)=>{const offset=date.getTimezoneOffset()*60000;return new Date(date.getTime()-offset).toISOString().slice(0,19);};
  const updateTimestamp=()=>{const raw=byId<HTMLInputElement>('timestampInput').value.trim();const value=Number(raw);if(!raw||!Number.isFinite(value)){byId('timestampResult').textContent='请输入有效数字';return;}const millis=Math.abs(value)<1e12?value*1000:value;const date=new Date(millis);byId('timestampResult').textContent=Number.isNaN(date.getTime())?'时间戳无效':`本地：${date.toLocaleString('zh-CN',{hour12:false})}\nUTC：${date.toISOString()}`;};
  const updateDate=()=>{const raw=byId<HTMLInputElement>('dateInput').value;const date=new Date(raw);byId('dateResult').textContent=!raw||Number.isNaN(date.getTime())?'请选择日期时间':`秒：${Math.floor(date.getTime()/1000)}\n毫秒：${date.getTime()}`;};
  const setNow=()=>{const now=new Date();byId<HTMLInputElement>('timestampInput').value=String(Date.now());byId<HTMLInputElement>('dateInput').value=localInputValue(now);updateTimestamp();updateDate();};
  byId('timestampInput').addEventListener('input',updateTimestamp);byId('dateInput').addEventListener('input',updateDate);byId('timestampNow').addEventListener('click',setNow);setNow();

  const base64Encode=(value:string)=>{const bytes=new TextEncoder().encode(value);let binary='';for(const byte of bytes)binary+=String.fromCharCode(byte);return btoa(binary);};
  const base64Decode=(value:string)=>{let normalized=value.replace(/\s/g,'').replace(/-/g,'+').replace(/_/g,'/');if(!/^[A-Za-z0-9+/]*={0,2}$/.test(normalized)||normalized.length%4===1||/=/.test(normalized.slice(0,-2)))throw new Error('invalid');normalized=normalized.replace(/=+$/,'').padEnd(Math.ceil(normalized.length/4)*4,'=');const binary=atob(normalized);const bytes=Uint8Array.from(binary,character=>character.charCodeAt(0));return new TextDecoder('utf-8',{fatal:true}).decode(bytes);};
  document.querySelectorAll<HTMLButtonElement>('[data-base64]').forEach(button=>button.addEventListener('click',()=>{const input=byId<HTMLTextAreaElement>('base64Input');if(!input.value){status('base64Status','请先输入要处理的内容',true);input.focus();return;}try{input.value=button.dataset.base64==='encode'?base64Encode(input.value):base64Decode(input.value);status('base64Status',button.dataset.base64==='encode'?'编码完成':'解码完成');}catch{status('base64Status','内容不是有效的 Base64 或 UTF-8 文本',true);}}));
  document.querySelectorAll<HTMLButtonElement>('[data-url]').forEach(button=>button.addEventListener('click',()=>{const input=byId<HTMLTextAreaElement>('urlInput');if(!input.value){status('urlStatus','请先输入要处理的内容',true);input.focus();return;}if(button.dataset.url==='decode'&&!/%[0-9A-Fa-f]{2}/.test(input.value)){status('urlStatus','未检测到可解码的 %xx 内容');return;}try{const result=button.dataset.url==='encode'?encodeURIComponent(input.value):decodeURIComponent(input.value);if(result===input.value){status('urlStatus','当前内容无需转换');return;}input.value=result;status('urlStatus',button.dataset.url==='encode'?'编码完成':'解码完成');}catch{status('urlStatus','URL 编码不完整，无法解码',true);}}));

  const generateUuid=()=>{byId<HTMLInputElement>('uuidOutput').value=crypto.randomUUID();status('uuidStatus','已生成新的 UUID');};byId('uuidGenerate').addEventListener('click',generateUuid);generateUuid();
  byId('hashInput').addEventListener('input',()=>{byId<HTMLTextAreaElement>('hashOutput').value='';status('hashStatus','');});
  byId('hashGenerate').addEventListener('click',async()=>{const input=byId<HTMLTextAreaElement>('hashInput');const output=byId<HTMLTextAreaElement>('hashOutput');if(!input.value){output.value='';status('hashStatus','请先输入要计算的文本',true);input.focus();return;}try{const digest=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(input.value));output.value=Array.from(new Uint8Array(digest),byte=>byte.toString(16).padStart(2,'0')).join('');status('hashStatus','计算完成');}catch{status('hashStatus','当前浏览器不支持 Web Crypto',true);}});

  const decodeJwtPart=(part:string)=>{if(!part||!/^[A-Za-z0-9_-]+$/.test(part))throw new Error('Token 包含无效字符');const decoded=base64Decode(part);const value=JSON.parse(decoded);if(!value||typeof value!=='object'||Array.isArray(value))throw new Error('Header 和 Payload 必须是 JSON 对象');return value as Record<string,unknown>;};
  byId('jwtInput').addEventListener('input',()=>{byId<HTMLTextAreaElement>('jwtOutput').value='';status('jwtStatus','');});
  byId('jwtDecode').addEventListener('click',()=>{const input=byId<HTMLTextAreaElement>('jwtInput');const output=byId<HTMLTextAreaElement>('jwtOutput');const token=input.value.trim();if(!token){status('jwtStatus','请先输入 JWT Token',true);input.focus();return;}const parts=token.split('.');if(parts.length!==3||parts.some(part=>!part)){status('jwtStatus','JWT 必须由 Header、Payload、Signature 三段组成',true);return;}try{const header=decodeJwtPart(parts[0]);const payload=decodeJwtPart(parts[1]);output.value=JSON.stringify({header,payload},null,2);const expiration=typeof payload.exp==='number'?new Date(payload.exp*1000):null;const expirationText=expiration&&!Number.isNaN(expiration.getTime())?`；过期时间：${expiration.toLocaleString('zh-CN',{hour12:false})}${expiration.getTime()<Date.now()?'（已过期）':''}`:'';status('jwtStatus',`解析完成，但未验证签名${expirationText}`);}catch(error){output.value='';status('jwtStatus',`无法解析 JWT：${(error as Error).message}`,true);}});

  const radixNames:Record<number,string>={2:'二进制',8:'八进制',10:'十进制',16:'十六进制'};
  const radixPatterns:Record<number,RegExp>={2:/^-?[01]+$/,8:/^-?[0-7]+$/,10:/^-?\d+$/,16:/^-?[0-9a-f]+$/i};
  const parseRadix=(raw:string,base:number)=>{const negative=raw.startsWith('-');const digits=negative?raw.slice(1):raw;const prefix=base===2?'0b':base===8?'0o':base===16?'0x':'';const value=BigInt(`${prefix}${digits}`);return negative?-value:value;};
  const radixInputs=Array.from(document.querySelectorAll<HTMLInputElement>('[data-radix]'));
  const resetOtherRadix=(active:HTMLInputElement)=>radixInputs.forEach(input=>{if(input!==active)input.value='';});
  const setRadixSource=(active:HTMLInputElement)=>radixInputs.forEach(input=>input.closest('.radix-row')?.classList.toggle('is-source',input===active));
  radixInputs.forEach(input=>{input.addEventListener('focus',()=>setRadixSource(input));input.addEventListener('input',()=>{setRadixSource(input);const raw=input.value.trim();const base=Number(input.dataset.radix);input.removeAttribute('aria-invalid');if(!raw){resetOtherRadix(input);status('radixStatus','');return;}if(raw.length>1024){resetOtherRadix(input);input.setAttribute('aria-invalid','true');status('radixStatus','数字过长，最多支持 1024 位',true);return;}if(!radixPatterns[base]?.test(raw)){resetOtherRadix(input);input.setAttribute('aria-invalid','true');status('radixStatus',`请输入${radixNames[base]}允许的字符`,true);return;}try{const value=parseRadix(raw,base);radixInputs.forEach(target=>{if(target!==input){target.value=value.toString(Number(target.dataset.radix)).toUpperCase();target.removeAttribute('aria-invalid');}});status('radixStatus','已实时换算其他进制');}catch{resetOtherRadix(input);input.setAttribute('aria-invalid','true');status('radixStatus','数字无法转换，请检查输入',true);}});});
  byId('radixClear').addEventListener('click',()=>{radixInputs.forEach(input=>{input.value='';input.removeAttribute('aria-invalid');input.closest('.radix-row')?.classList.remove('is-source');});status('radixStatus','');radixInputs[0].focus();});

  const updateTextStats=()=>{const value=byId<HTMLTextAreaElement>('textInput').value;const chars=Array.from(value).length;const noSpaces=Array.from(value.replace(/\s/g,'')).length;let words=0;if(value.trim()){if('Segmenter' in Intl){const Segmenter=(Intl as typeof Intl & {Segmenter:new(locale:string,options:{granularity:'word'})=>{segment:(value:string)=>Iterable<{isWordLike?:boolean}>}}).Segmenter;words=Array.from(new Segmenter('zh-CN',{granularity:'word'}).segment(value)).filter(item=>item.isWordLike).length;}else{words=value.trim().split(/\s+/).length;}}byId('textChars').textContent=String(chars);byId('textNoSpaces').textContent=String(noSpaces);byId('textWords').textContent=String(words);byId('textLines').textContent=String(value?value.split(/\r\n?|\n/).length:0);byId('textBytes').textContent=String(new TextEncoder().encode(value).length);status('textStatus','');};
  byId('textInput').addEventListener('input',updateTextStats);updateTextStats();

  const passwordSets={lower:'abcdefghijklmnopqrstuvwxyz',upper:'ABCDEFGHIJKLMNOPQRSTUVWXYZ',digits:'0123456789',symbols:'!@#$%^&*()-_=+[]{};:,.?'};
  const secureIndex=(maximum:number)=>{if(!Number.isSafeInteger(maximum)||maximum<1||maximum>0x100000000)throw new Error('随机范围无效');const limit=0x100000000-(0x100000000%maximum);const values=new Uint32Array(1);do{crypto.getRandomValues(values);}while(values[0]>=limit);return values[0]%maximum;};
  const generatePassword=()=>{const output=byId<HTMLInputElement>('passwordOutput');const length=Number(byId<HTMLInputElement>('passwordLength').value);const selected=[byId<HTMLInputElement>('passwordLower').checked?passwordSets.lower:'',byId<HTMLInputElement>('passwordUpper').checked?passwordSets.upper:'',byId<HTMLInputElement>('passwordDigits').checked?passwordSets.digits:'',byId<HTMLInputElement>('passwordSymbols').checked?passwordSets.symbols:''].filter(Boolean);if(!selected.length){output.value='';status('passwordStatus','请至少选择一种字符类型',true);return;}const combined=selected.join('');const result=selected.map(set=>set[secureIndex(set.length)]);while(result.length<length)result.push(combined[secureIndex(combined.length)]);for(let index=result.length-1;index>0;index--){const swap=secureIndex(index+1);[result[index],result[swap]]=[result[swap],result[index]];}output.value=result.join('');status('passwordStatus',`已生成 ${length} 位安全随机密码`);};
  byId('passwordGenerate').addEventListener('click',generatePassword);byId('passwordLength').addEventListener('input',()=>{byId('passwordLengthValue').textContent=byId<HTMLInputElement>('passwordLength').value;generatePassword();});['passwordLower','passwordUpper','passwordDigits','passwordSymbols'].forEach(id=>byId(id).addEventListener('change',generatePassword));generatePassword();
  document.querySelectorAll<HTMLButtonElement>('[data-random-mode]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll<HTMLButtonElement>('[data-random-mode]').forEach(item=>item.classList.toggle('active',item===button));document.querySelectorAll<HTMLElement>('[data-random-panel]').forEach(panel=>panel.hidden=panel.dataset.randomPanel!==button.dataset.randomMode);}));

  type LotteryEntry={name:string;probability:number};
  const parseLotteryEntries=(raw:string)=>{const lines=raw.split(/\r?\n/).map(line=>line.trim()).filter(Boolean);if(!lines.length)throw new Error('请先填写奖品和概率');if(lines.length>100)throw new Error('奖品最多支持 100 项');const entries=lines.map((line,index)=>{const parts=line.split('|').map(part=>part.trim());if(parts.length!==2||!parts[0])throw new Error(`第 ${index+1} 行格式应为：奖品 | 概率`);const probability=Number(parts[1].replace(/%$/,'').trim());if(!Number.isFinite(probability)||probability<=0||probability>100)throw new Error(`第 ${index+1} 行概率必须大于 0 且不超过 100%`);return {name:parts[0],probability};});if(new Set(entries.map(entry=>entry.name)).size!==entries.length)throw new Error('奖品名称不能重复');return entries;};
  const secureRandom=()=>{const value=new Uint32Array(1);crypto.getRandomValues(value);return value[0]/0x100000000;};
  const renderLottery=(title:string,items:string[])=>{const result=byId('lotteryResult');result.replaceChildren();const heading=document.createElement('strong');heading.textContent=title;result.append(heading);items.forEach(item=>{const row=document.createElement('div');row.textContent=item;result.append(row);});};
  document.querySelectorAll<HTMLButtonElement>('[data-lottery-mode]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll<HTMLButtonElement>('[data-lottery-mode]').forEach(item=>item.classList.toggle('active',item===button));document.querySelectorAll<HTMLElement>('[data-lottery-panel]').forEach(panel=>panel.hidden=panel.dataset.lotteryPanel!==button.dataset.lotteryMode);byId('lotteryResult').textContent='等待抽取';status('lotteryStatus','');}));
  byId('lotteryDrawA').addEventListener('click',()=>{try{const prizes=parseLotteryEntries(byId<HTMLTextAreaElement>('lotteryPrizesA').value);const people=byId<HTMLTextAreaElement>('lotteryPeople').value.split(/\r?\n/).map(name=>name.trim()).filter(Boolean);if(!people.length)throw new Error('请先填写候选人');if(people.length>1000)throw new Error('候选人最多支持 1000 人');if(new Set(people).size!==people.length)throw new Error('候选人名单存在重复姓名');const pool=[...people];const winners:string[]=[];for(const prize of prizes){if(secureRandom()*100>=prize.probability)continue;if(!pool.length)break;const index=secureIndex(pool.length);const [person]=pool.splice(index,1);winners.push(`${prize.name} · ${person}`);}renderLottery(winners.length?'中奖结果':'本轮无人中奖',winners.length?winners:['所有奖品均未命中设定概率']);status('lotteryStatus',`已完成 ${prizes.length} 个奖品的独立概率抽取`);}catch(error){byId('lotteryResult').textContent='——';status('lotteryStatus',(error as Error).message,true);}});
  byId('lotteryDrawB').addEventListener('click',()=>{try{const prizes=parseLotteryEntries(byId<HTMLTextAreaElement>('lotteryPrizesB').value);const total=prizes.reduce((sum,entry)=>sum+entry.probability,0);if(total>100.000001)throw new Error(`总概率为 ${total}%，不能超过 100%`);const roll=secureRandom()*100;let cursor=0;let selected:LotteryEntry|undefined;for(const prize of prizes){cursor+=prize.probability;if(roll<cursor){selected=prize;break;}}renderLottery(selected?'抽取结果':'未中奖',[selected?selected.name:'本次落在未中奖概率区间']);status('lotteryStatus',`本次随机值 ${roll.toFixed(4)} / 100`);}catch(error){byId('lotteryResult').textContent='——';status('lotteryStatus',(error as Error).message,true);}});

  const updateRegex=()=>{const pattern=byId<HTMLInputElement>('regexPattern').value;const flags=byId<HTMLInputElement>('regexFlags').value.trim();const value=byId<HTMLTextAreaElement>('regexText').value;const result=byId('regexResult');if(!pattern||!value){result.textContent='——';status('regexStatus','');return;}if(!/^[dgimsuvy]*$/.test(flags)||new Set(flags).size!==flags.length){result.textContent='——';status('regexStatus','正则标志无效或重复',true);return;}try{const regex=new RegExp(pattern,flags.includes('g')?flags:`${flags}g`);const matches=Array.from(value.matchAll(regex)).slice(0,100);result.textContent=matches.length?matches.map((match,index)=>`${index+1}. ${match[0]||'（空匹配）'} · 位置 ${match.index}`).join('\n'):'——';status('regexStatus',matches.length?`找到 ${matches.length}${matches.length===100?' 个以上':' 个'}匹配`:'没有匹配结果');}catch(error){result.textContent='——';status('regexStatus',`表达式错误：${(error as Error).message}`,true);}};
  ['regexPattern','regexFlags','regexText'].forEach(id=>byId(id).addEventListener('input',updateRegex));

  const setColor=(hex:string)=>{const normalized=hex.toUpperCase();const r=parseInt(normalized.slice(1,3),16),g=parseInt(normalized.slice(3,5),16),b=parseInt(normalized.slice(5,7),16);byId<HTMLInputElement>('colorPicker').value=normalized;byId<HTMLInputElement>('colorHex').value=normalized;byId<HTMLInputElement>('colorRgb').value=`rgb(${r}, ${g}, ${b})`;byId<HTMLElement>('colorPreview').style.background=normalized;status('colorStatus','');};
  byId('colorPicker').addEventListener('input',event=>setColor((event.target as HTMLInputElement).value));byId('colorHex').addEventListener('input',event=>{let value=(event.target as HTMLInputElement).value.trim();if(/^#[0-9a-f]{3}$/i.test(value))value='#'+value.slice(1).split('').map(char=>char+char).join('');if(!/^#[0-9a-f]{6}$/i.test(value)){status('colorStatus','请输入 #RRGGBB 或 #RGB 格式',true);return;}setColor(value);});byId('colorRgb').addEventListener('input',event=>{const match=(event.target as HTMLInputElement).value.match(/^\s*(?:rgb\()?\s*(\d{1,3})\s*[, ]\s*(\d{1,3})\s*[, ]\s*(\d{1,3})\s*\)?\s*$/i);if(!match){status('colorStatus','请输入 rgb(0–255, 0–255, 0–255)',true);return;}const values=match.slice(1).map(Number);if(values.some(value=>value>255)){status('colorStatus','RGB 每项必须在 0–255 之间',true);return;}setColor('#'+values.map(value=>value.toString(16).padStart(2,'0')).join(''));});setColor('#3B82F6');

  const clearQrResult=()=>{const canvas=byId<HTMLCanvasElement>('qrCanvas');canvas.hidden=true;byId<HTMLElement>('qrPreview').querySelector('span')!.hidden=false;byId<HTMLButtonElement>('qrDownload').disabled=true;status('qrStatus','');};
  byId('qrInput').addEventListener('input',clearQrResult);
  byId('qrGenerate').addEventListener('click',async()=>{const input=byId<HTMLTextAreaElement>('qrInput'),value=input.value.trim(),canvas=byId<HTMLCanvasElement>('qrCanvas');if(!value){clearQrResult();status('qrStatus','请先输入网址或文本',true);input.focus();return;}try{await QRCode.toCanvas(canvas,value,{width:256,margin:2,errorCorrectionLevel:'H',color:{dark:'#111111',light:'#ffffff'}});canvas.hidden=false;byId<HTMLElement>('qrPreview').querySelector('span')!.hidden=true;byId<HTMLButtonElement>('qrDownload').disabled=false;status('qrStatus','已生成 256 × 256 高纠错二维码');}catch{clearQrResult();status('qrStatus','内容过长，最高纠错级别无法容纳',true);}});
  byId('qrDownload').addEventListener('click',()=>{const canvas=byId<HTMLCanvasElement>('qrCanvas');if(canvas.hidden){status('qrStatus','请先生成二维码',true);return;}const link=document.createElement('a');link.download='qrcode.png';link.href=canvas.toDataURL('image/png');link.click();status('qrStatus','PNG 已下载');});
  byId('qrClear').addEventListener('click',()=>{byId<HTMLTextAreaElement>('qrInput').value='';clearQrResult();byId('qrInput').focus();});

  const toolSearch=byId<HTMLInputElement>('toolSearch');
  toolSearch.addEventListener('input',()=>{const query=toolSearch.value.trim().toLowerCase();let count=0;toolTabs.forEach(tab=>{const visible=!query||!!tab.textContent?.toLowerCase().includes(query);tab.hidden=!visible;if(visible)count++;});byId('toolNoResults').hidden=count>0;});

  const randomInt=(min:number,max:number)=>{const range=max-min+1;if(range<=0||range>0x100000000)throw new Error('范围过大');const limit=0x100000000-(0x100000000%range);const buffer=new Uint32Array(1);do{crypto.getRandomValues(buffer);}while(buffer[0]>=limit);return min+(buffer[0]%range);};
  byId('randomGenerate').addEventListener('click',()=>{const min=Number(byId<HTMLInputElement>('randomMin').value),max=Number(byId<HTMLInputElement>('randomMax').value),count=Number(byId<HTMLInputElement>('randomCount').value),unique=byId<HTMLInputElement>('randomUnique').checked,output=byId<HTMLTextAreaElement>('randomOutput');if(![min,max,count].every(Number.isSafeInteger)||count<1||count>100||min>max){output.value='';status('randomStatus','请输入有效整数：数量 1–100，最小值不能大于最大值',true);return;}if(unique&&max-min+1<count){output.value='';status('randomStatus','当前范围不足以生成指定数量的不重复数字',true);return;}try{const values:number[]=[];while(values.length<count){const value=randomInt(min,max);if(!unique||!values.includes(value))values.push(value);}output.value=values.join(', ');status('randomStatus',`已生成 ${count} 个随机数`);}catch{output.value='';status('randomStatus','取值范围过大，请缩小范围',true);}});
</script>

<style>
  .radix-hint{margin-bottom:14px;color:var(--color-muted);font-size:.8rem}.radix-fields{display:grid;gap:9px}.radix-row{display:grid;grid-template-columns:112px minmax(0,1fr);gap:12px;align-items:center;padding:8px;border:1px solid transparent;border-radius:11px;transition:border-color var(--transition-fast),background var(--transition-fast)}.radix-row.is-source{border-color:color-mix(in srgb,var(--color-accent) 35%,var(--color-border));background:color-mix(in srgb,var(--color-accent) 5%,transparent)}.radix-row label{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin:0;padding-left:3px}.radix-row label span{color:var(--color-foreground);font-family:inherit;font-weight:650}.radix-row label small{color:var(--color-muted);font-size:.67rem}.radix-row>div{display:grid;grid-template-columns:minmax(0,1fr) auto}.radix-row input{border-radius:8px 0 0 8px}.radix-row input[aria-invalid='true']{border-color:#d14343;box-shadow:0 0 0 2px color-mix(in srgb,#d14343 12%,transparent)}.radix-row button{min-width:54px;border:1px solid var(--color-border);border-left:0;border-radius:0 8px 8px 0;background:var(--color-card);color:var(--color-muted);font-size:.75rem}.radix-row button:hover{color:var(--color-accent)}.radix-actions{justify-content:flex-end;margin-top:8px}.radix-actions .ghost{min-height:34px;padding:5px 8px;font-size:.75rem}
