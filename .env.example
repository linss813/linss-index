# ===========================================
# Luen0511 Home V2 环境变量示例
# 复制为 .env 并填写实际值，.env 不提交 Git
# ===========================================

# SQLite 数据库文件路径
DATABASE_URL=./data/luen0511-home/database.sqlite

# Session 加密密钥（请使用随机长字符串）
SESSION_SECRET=change-me-to-a-random-long-string

# 初始管理员密码（首次启动时用于创建管理员账号）
ADMIN_INITIAL_PASSWORD=admin123456

# 文件上传目录
UPLOAD_DIR=./data/luen0511-home/uploads

# 最大上传文件大小（字节，默认 10MB）
MAX_UPLOAD_SIZE=10485760

# RSS 定时同步（默认启用，每 30 分钟；最小 5 分钟）
RSS_SYNC_ENABLED=true
RSS_SYNC_INTERVAL_MINUTES=30

# 端口（Astro Node Adapter 监听端口）
PORT=4321

# 运行环境
NODE_ENV=development
